# The uXRCE-DDS agent.
#
# This is the optional path. It puts PX4 uORB topics straight onto the ROS 2
# graph, which is faster and richer than MAVLink, and which breaks the
# "MAVLink and RTSP only" rule the rest of the stack follows.
#
# Turn it on only for a stack that needs px4_msgs:
#   COMPOSE_PROFILES=ros,xrce docker compose up -d
#
# PX4 must also be told where the agent is. Add this to .env:
#   PX4_PARAM_UXRCE_DDS_AG_IP  the agent address as a signed 32-bit integer
# See docs/development.md.

FROM ubuntu:24.04

ARG XRCE_AGENT_REF=v2.4.2
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# The version follows the PX4 user guide for this release. A mismatch between
# the agent and the PX4 client shows up as topics that never appear.
RUN git clone --depth 1 -b "${XRCE_AGENT_REF}" \
      https://github.com/eProsima/Micro-XRCE-DDS-Agent.git /src \
    && cmake -S /src -B /src/build -DCMAKE_BUILD_TYPE=Release -DUAGENT_BUILD_EXECUTABLE=ON \
    && cmake --build /src/build --parallel "$(nproc)" \
    && cmake --install /src/build \
    && ldconfig \
    && rm -rf /src

EXPOSE 8888/udp

CMD ["MicroXRCEAgent", "udp4", "-p", "8888"]
