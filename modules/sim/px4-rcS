#!/bin/sh
# PX4 startup for px4-sim-stack.
#
# This runs the stock PX4 startup unchanged, then adds one MAVLink link.
# It is passed to PX4 with `px4 -s`, so the PX4 source tree stays clean and
# `git status` in src/PX4-Autopilot shows only your own work.
#
# ---------------------------------------------------------------------------
# Why the extra link exists
#
# PX4's own ground station link is `mavlink start -x -u 18570 -r 4000000 -f`.
# That is a UDP server with no configured peer. It learns the peer from the
# first packet it receives, and PX4 then keeps that address forever:
#
#   mavlink_receiver.cpp: the peer is recorded only when
#   get_client_source_initialized() is false, and nothing ever clears it.
#
# mavlink-router connects to PX4 from an ephemeral source port. So when the
# hub container restarts, its source port changes, PX4 keeps sending to the old
# one, and telemetry stops with no error on either side. Restarting the hub
# would mean restarting the simulator.
#
# The -t flag sets the partner address up front, which marks the address as
# initialized. This link pushes to a fixed address and port, so:
#
#   - PX4 speaks first, and no handshake is needed.
#   - The hub can restart as often as you like. PX4 keeps sending to the same
#     address, and the hub relearns PX4 from the first packet.
#   - The simulator can restart. The hub is a server on this port and waits.
#
# MAVLINK_HUB_IP and MAVLINK_HUB_PORT come from the container environment.
# ---------------------------------------------------------------------------

. etc/init.d-posix/rcS

mavlink start -x -u 14569 -o ${MAVLINK_HUB_PORT} -t ${MAVLINK_HUB_IP} -r 4000000 -f

# The rates PX4's own ground station link uses. Without these the position and
# attitude messages arrive too slowly for a smooth QGroundControl display.
mavlink stream -r 50 -s POSITION_TARGET_LOCAL_NED -u 14569
mavlink stream -r 50 -s LOCAL_POSITION_NED -u 14569
mavlink stream -r 50 -s GLOBAL_POSITION_INT -u 14569
mavlink stream -r 50 -s ATTITUDE -u 14569
mavlink stream -r 50 -s ATTITUDE_QUATERNION -u 14569
mavlink stream -r 50 -s ATTITUDE_TARGET -u 14569
mavlink stream -r 50 -s SERVO_OUTPUT_RAW_0 -u 14569
mavlink stream -r 20 -s RC_CHANNELS -u 14569
mavlink stream -r 10 -s OPTICAL_FLOW_RAD -u 14569
mavlink stream -r 10 -s DISTANCE_SENSOR -u 14569

# The gimbal setpoint, and the mount orientation as a second opinion.
#
# Neither is in the default stream set for a normal-mode link, so the ROS side
# saw the topics exist and never receive anything. Both carry the gimbal angles
# *relative to the airframe*, which is what a camera frame needs.
#
# GIMBAL_DEVICE_ATTITUDE_STATUS, the one that does stream by default, is the
# message PX4 fills from the gimbal IMU and mislabels as vehicle relative. See
# patches/px4-gzgimbal-frame.patch. Requesting these two gives the frame tree a
# source that does not need that lie undone.
mavlink stream -r 20 -s GIMBAL_DEVICE_SET_ATTITUDE -u 14569
mavlink stream -r 20 -s MOUNT_ORIENTATION -u 14569
