<?xml version="1.0"?>
<model>
  <name>chimera_common</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    The payload both Chimera marks carry: a three axis gimbal, yaw, roll and
    pitch, with a 50 m rangefinder along its boresight, plus a 200 m body
    rangefinder. The cameras belong to the mark, not to this model.
    chimera_v2 and chimera_v3 merge it. Nothing spawns it on its own.
  </description>
</model>
