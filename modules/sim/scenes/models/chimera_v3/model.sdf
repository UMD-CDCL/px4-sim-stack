<?xml version="1.0" encoding="UTF-8"?>
<!--
  chimera_v3 - the later Chimera mark. Everything v2 carries, and one more
  camera bolted to the airframe looking straight down.

  This file is a template. The sim entrypoint runs envsubst over it and writes
  one model for each vehicle, because the lens differs from vehicle to vehicle.
  The values come from UAS_GIMBAL_HFOV_DEG, UAS_THERMAL_HFOV_DEG and
  UAS_DOWN_HFOV_DEG. The calibration files in
  5g_drone/config/camera_calibration_files/ stay the authority for the
  fixed-lens cameras; .env.example says where each number came from.

  The gimbal camera is three cameras, one for each framing the zoom lens
  reaches, from UAS_ZOOM_PRESETS in scripts/zoom.sh. Widest first: the widest
  is the one the fixed-lens naming already calls gimbal_camera, so nothing
  that reads a v2 or a thermal camera changes.

  Streams: rgb<N> and rgbl<N> from whichever gimbal camera the lens is on,
           pilot<N> and pilotl<N> from the down-facing camera,
           thermal<N> and thermall<N> from the thermal camera.
  See streams.conf.

  Airframe: SYS_AUTOSTART 4019, as v2.
-->
<sdf version='1.9'>
  <model name='chimera_v3'>
    <include merge='true'>
      <uri>model://chimera_common</uri>
    </include>

    <!-- ====================================================== gimbal camera -->
    <!-- At the gimbal frame. MAVInsight records the gimbal RGB camera with a
         zero offset from its parent, so the two points are the same one. -->
    <link name="gimbal_camera_link">
      <pose relative_to="camera_link">-0.074 0 -0.162 0 0 3.14</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00001</iyy><iyz>0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <sensor name="gimbal_camera" type="camera">
        <gz_frame_id>gimbal_camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>${GIMBAL_HFOV_RAD}</horizontal_fov>
          <image>
            <format>R8G8B8</format>
            <width>1920</width>
            <height>1080</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>3000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
      </sensor>

      <!-- The rest of the zoom lens. gz-sim cannot change a camera's field of
           view once the world is loaded, so the lens is one camera for each
           framing it reaches, all on this mount and all rendering full size.
           gz_video_streamer reads whichever one covers what the lens is
           asking for and crops between them, so a framing has real detail
           rather than a tenth of the picture stretched back up.

           A Gazebo camera renders only while something subscribes to its
           topic, so the framings not in use cost nothing. The idle pilot and
           thermal cameras on this airframe are the same arrangement.

           The topics are named outright rather than left to default, because
           several cameras on one link is exactly where a default name is
           worth not guessing at. UAS_NUM makes them unique per vehicle.
           Widest first, so 2 is the second widest framing and 3 the third.
           The entry point fills all of this in; see modules/sim/entrypoint.sh
           and scripts/zoom.sh. -->
      <sensor name="gimbal_camera_2" type="camera">
        <gz_frame_id>gimbal_camera_link</gz_frame_id>
        <topic>/uas${UAS_NUM}/camera/framing/2</topic>
        <camera>
          <horizontal_fov>${GIMBAL_HFOV_2_RAD}</horizontal_fov>
          <image>
            <format>R8G8B8</format>
            <width>1920</width>
            <height>1080</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>3000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
      </sensor>

      <sensor name="gimbal_camera_3" type="camera">
        <gz_frame_id>gimbal_camera_link</gz_frame_id>
        <topic>/uas${UAS_NUM}/camera/framing/3</topic>
        <camera>
          <horizontal_fov>${GIMBAL_HFOV_3_RAD}</horizontal_fov>
          <image>
            <format>R8G8B8</format>
            <width>1920</width>
            <height>1080</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>3000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="gimbal_camera_joint" type="fixed">
      <parent>camera_link</parent>
      <child>gimbal_camera_link</child>
    </joint>

    <!-- ===================================================== thermal camera -->
    <!-- Same boresight as the RGB camera, so a thermal pixel maps to an RGB
         pixel once the two fields of view are accounted for. -->
    <link name="thermal_camera_link">
      <pose relative_to="camera_link">-0.074 0 -0.162 0 0 3.14</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00001</iyy><iyz>0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <sensor name="thermal_camera" type="camera">
        <gz_frame_id>thermal_camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>${THERMAL_HFOV_RAD}</horizontal_fov>
          <image>
            <format>R8G8B8</format>
            <width>640</width>
            <height>512</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>3000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="thermal_camera_joint" type="fixed">
      <parent>camera_link</parent>
      <child>thermal_camera_link</child>
    </joint>

    <!-- ================================================= down-facing camera -->
    <!--
      At the base_link origin, which is the offset MAVInsight records in
      sensors/downward_facing_cam.yaml, rotated 90 degrees about Y so the
      camera's +X axis points down. It carries no visual: the real camera sits
      inside the airframe, and a housing there would render into its own view.

      Its field of view is a placeholder. No calibration file records this
      camera. See UAS_DOWN_HFOV_DEG in .env.example.
    -->
    <link name="pilot_camera_link">
      <pose relative_to="base_link">0 0 0 0 1.5707 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00004</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00004</iyy><iyz>0</iyz>
          <izz>0.00004</izz>
        </inertia>
      </inertial>
      <sensor name="pilot_camera" type="camera">
        <gz_frame_id>pilot_camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>${DOWN_HFOV_RAD}</horizontal_fov>
          <image>
            <format>R8G8B8</format>
            <width>1920</width>
            <height>1080</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>3000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="pilot_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>pilot_camera_link</child>
    </joint>

  </model>
</sdf>
