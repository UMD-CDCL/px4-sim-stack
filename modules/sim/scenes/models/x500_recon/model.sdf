<?xml version="1.0" encoding="UTF-8"?>
<!--
  x500_recon - the reconnaissance airframe for this stack.

  It carries three payloads:
    gimbal camera   1920x1080, 3-axis mount, from the PX4 gimbal model
    nadir camera    1920x1080, fixed, points straight down
    rangefinder     LW20 laser, points down, reaches 100 m

  Two names in this file are not free choices. PX4's Gazebo bridge subscribes
  to a fixed topic for the rangefinder:

    /world/<world>/model/<model>/link/lidar_sensor_link/sensor/lidar/scan

  So the link must be lidar_sensor_link and the sensor must be lidar. Rename
  either one and PX4 reports no distance sensor, with no error message.

  The gimbal camera keeps its upstream topic, because the camera encoder finds
  it by pattern. The nadir camera is ours, so it gets an explicit short topic.

  Airframe: use SYS_AUTOSTART 4019. That airframe sets the gimbal parameters
  and does not force a model name, so PX4_SIM_MODEL=gz_x500_recon still wins.
-->
<sdf version='1.9'>
  <model name='x500_recon'>
    <self_collide>false</self_collide>

    <!-- Frame, motors, IMU, magnetometer, barometer, GPS. -->
    <include merge='true'>
      <uri>model://x500</uri>
    </include>

    <!-- ================================================== gimbal camera -->
    <include merge='true'>
      <uri>model://gimbal</uri>
      <pose>0 0 0.26 0 0 3.14</pose>
    </include>
    <joint name="GimbalAttachJoint" type="fixed">
      <parent>base_link</parent>
      <child>cgo3_mount_link</child>
    </joint>

    <!-- =================================================== nadir camera -->
    <!-- Rotated 90 degrees about Y, so the camera's +X axis points down. -->
    <link name="nadir_camera_link">
      <pose relative_to="base_link">0.10 0 -0.06 0 1.5707 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00004</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00004</iyy><iyz>0</iyz>
          <izz>0.00004</izz>
        </inertia>
      </inertial>
      <visual name="nadir_camera/housing">
        <geometry>
          <box><size>0.02 0.04 0.04</size></box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <visual name="nadir_camera/lens">
        <pose>0.014 0 0 0 0 0</pose>
        <geometry>
          <sphere><radius>0.008</radius></sphere>
        </geometry>
        <material>
          <ambient>0.4 0.4 0.5 0.95</ambient>
          <diffuse>0.4 0.4 0.5 0.95</diffuse>
          <specular>1 1 1 1</specular>
        </material>
      </visual>
      <sensor name="nadir_camera" type="camera">
        <topic>/recon/nadir/image</topic>
        <gz_frame_id>nadir_camera_link</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.74</horizontal_fov>
          <image>
            <format>R8G8B8</format>
            <width>1920</width>
            <height>1080</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>3000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
      </sensor>
      <gravity>true</gravity>
    </link>
    <joint name="nadir_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>nadir_camera_link</child>
    </joint>

    <!-- ==================================================== rangefinder -->
    <!-- The visible LW20 body. -->
    <include merge='true'>
      <uri>model://LW20</uri>
      <pose relative_to="base_link">0 0 -0.079 0 1.57 0</pose>
    </include>
    <joint name="lidar_model_joint" type="fixed">
      <parent>base_link</parent>
      <child>lw20_link</child>
      <pose relative_to="base_link">0 0 0 0 0 0</pose>
    </joint>

    <!-- The ray itself. PX4 reads this one. -->
    <link name="lidar_sensor_link">
      <pose relative_to="base_link">0 0 -0.05 0 1.57 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00001</iyy><iyz>0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <sensor name='lidar' type='gpu_lidar'>
        <gz_frame_id>lidar_sensor_link</gz_frame_id>
        <pose>0 0 0 3.14 0 0</pose>
        <update_rate>50</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>100.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="lidar_sensor_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_sensor_link</child>
    </joint>

  </model>
</sdf>
