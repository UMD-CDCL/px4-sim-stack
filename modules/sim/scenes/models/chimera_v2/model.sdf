<?xml version="1.0" encoding="UTF-8"?>
<!--
  chimera_v2 - the earlier Chimera mark. The gimbal carries every camera.

  This file is a template. The sim entrypoint runs envsubst over it and writes
  one model for each vehicle, because the lens differs from vehicle to vehicle:
  uas13 and uas14 are both v2 and see 85.25 and 25.98 degrees. The values come
  from UAS_GIMBAL_HFOV_DEG and UAS_THERMAL_HFOV_DEG. The calibration files in
  5g_drone/config/camera_calibration_files/ stay the authority; .env.example
  says where each number came from.

  Streams: pilot<N> and pilotl<N> from the gimbal camera,
           thermal<N> and thermall<N> from the thermal camera.
  See streams.conf.

  Airframe: SYS_AUTOSTART 4019. That airframe sets the gimbal parameters and
  does not force a model name, so PX4_SIM_MODEL wins.
-->
<sdf version='1.9'>
  <model name='chimera_v2'>
    <include merge='true'>
      <uri>model://chimera_common</uri>
    </include>

    <!-- ====================================================== gimbal camera -->
    <!-- At the gimbal frame. MAVInsight records the gimbal RGB camera with a
         zero offset from its parent, so the two points are the same one. -->
    <link name="gimbal_camera_link">
      <pose relative_to="camera_link">-0.074 0 -0.162 0 0 3.14</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00001</iyy><iyz>0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <sensor name="gimbal_camera" type="camera">
        <gz_frame_id>gimbal_camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>${GIMBAL_HFOV_RAD}</horizontal_fov>
          <image>
            <format>R8G8B8</format>
            <width>1920</width>
            <height>1080</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>3000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="gimbal_camera_joint" type="fixed">
      <parent>camera_link</parent>
      <child>gimbal_camera_link</child>
    </joint>

    <!-- ===================================================== thermal camera -->
    <!-- Same boresight as the RGB camera, so a thermal pixel maps to an RGB
         pixel once the two fields of view are accounted for. -->
    <link name="thermal_camera_link">
      <pose relative_to="camera_link">-0.074 0 -0.162 0 0 3.14</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00001</iyy><iyz>0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <sensor name="thermal_camera" type="camera">
        <gz_frame_id>thermal_camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>${THERMAL_HFOV_RAD}</horizontal_fov>
          <image>
            <format>R8G8B8</format>
            <width>640</width>
            <height>512</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>3000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="thermal_camera_joint" type="fixed">
      <parent>camera_link</parent>
      <child>thermal_camera_link</child>
    </joint>

  </model>
</sdf>
