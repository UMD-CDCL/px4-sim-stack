<?xml version="1.0" encoding="UTF-8"?>
<!--
  allsmoke - generated by modules/scenegen from real map data.

  Center 39.096800, -120.032400, side 120 m.
  Ground truth for the layout is data/allsmoke/scene.json in the
  scenegen module. Edit that and rebuild; an edit here does not survive
  the next build.

  The <world name> must match the file name. The sim entrypoint checks it.
-->
<sdf version="1.9">
  <world name="allsmoke">

    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <grid>false</grid>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.62 0.72 0.85 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.3 0.5 -0.81</direction>
      <diffuse>0.95 0.93 0.88 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <include>
      <uri>model://allsmoke_terrain</uri>
      <name>allsmoke_terrain</name>
      <pose>0 0 0 0 0 0</pose>
    </include>


    <!-- The survey fiducial. FIDUCIAL_SURVEYED_* in .env holds its
         coordinate; the drone measures it to align frames. -->
    <model name="fiducial_marker">
      <static>true</static>
      <pose>0.000 0.000 0.012 0 0 0.0000</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.250</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 0.45 0.05 1</ambient>
            <diffuse>1 0.45 0.05 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>39.0968000</latitude_deg>
      <longitude_deg>-120.0324000</longitude_deg>
      <elevation>1897.55</elevation>
    </spherical_coordinates>

  </world>
</sdf>
