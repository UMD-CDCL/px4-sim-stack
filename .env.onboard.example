# One real aircraft. deploy_onboard.sh normally writes these values.
COMPOSE_PROFILES=aircraft
UAS_BASE=0
UAS_NUM=1                         # replace per aircraft: 1, 3 or 4
UAS_MODEL=v3                      # v2 or v3; must match the aircraft
GROUND_DOMAIN=60
RTSP_BASE=rtsp://127.0.0.1:8554
MAVROS_PATCH=1
PX4SIM_PINNED_DEPS=1
PX4SIM_REUSE_PREPARED_IMAGES=1
