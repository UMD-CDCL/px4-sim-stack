# Real ground station. Copy to .env, then run ./px4sim preflight.
COMPOSE_PROFILES=ground
UAS_BASE=0
UAS_FLEET="chimera_v3 chimera_v3 chimera_v2 chimera_v2"
UAS_ACTIVE="1 2 3 4"
UAS_STREAMS="gimbal"
GROUND_DOMAIN=60
RTSP_BASE=rtsp://127.0.0.1:8554
RTSP_HOST_PORT=8654
SIMNET_PREFIX=172.28.0

# The ground station uses the same scene only for visualization.
SCENE=uroc
SCENARIO=uroc_casualties

# These settings select the known-good, pinned MAVROS build inputs.
MAVROS_PATCH=1
PX4SIM_PINNED_DEPS=1
PX4SIM_REUSE_PREPARED_IMAGES=1
