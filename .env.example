# px4-sim-stack configuration.
# Copy this file to .env and edit it. `make preflight` fills in the host values.

# ---------------------------------------------------------------- host identity
# The sim and ros containers write build output into bind-mounted source trees.
# These values must match your host user, or the output belongs to root.
HOST_UID=1000
HOST_GID=1000

# X11 forwarding. `make x11` writes the cookie file.
# Keep this inside the project. Docker turns a missing bind-mount source into
# a directory, and one under /tmp ends up owned by root and needs sudo.
#
# This file does not set DISPLAY. Both front doors export it over their own
# environment. A value here would pin every container to one display, and hide
# the display of the session that starts them. compose.yaml defaults it to :0.
XAUTH_FILE=./.xauth

# ------------------------------------------------------------ component versions
# Change one line to test a different upstream version. See docs/development.md.
PX4_REF=v1.17.0
QGC_REF=v5.0.8
ROS_DISTRO=jazzy
GZ_DISTRO=harmonic
MEDIAMTX_TAG=1
XRCE_AGENT_REF=v2.4.2

# DeepStream 8.0 needs driver 570.133 or later. DeepStream 9.0 needs 590.48.
# The driver decides, so auto reads it and takes the newest release it
# supports. `./px4sim doctor` prints the answer for this machine.
#
# Pin it to 8.0 or 9.0 to reproduce a result on a machine with another driver.
# DS_IMAGE overrides both, for an image this stack does not know about, such as
# a triton flavour. See scripts/ds-select.sh.
DS_VERSION=auto
# DS_IMAGE=nvcr.io/nvidia/deepstream:8.0-samples-multiarch

# --------------------------------------------------------------- which modules run
# Remove a name to keep that module down. sim, mavlink-hub, video-router,
# message-bus and qgc always run.
COMPOSE_PROFILES=ros,perception

# ------------------------------------------------------------------- the scenario
# SCENE picks a world file from modules/sim/scenes/worlds/<SCENE>.sdf
# VEHICLE picks a model from modules/sim/scenes/models/<VEHICLE>/model.sdf
# AIRFRAME is the PX4 SYS_AUTOSTART id. 4019 is the gimbal-enabled x500.
SCENE=recon_field
VEHICLE=x500_recon
AIRFRAME=4019
SCENARIO=urban_casualties

# Gazebo GUI. Set to 0 for a headless run.
GZ_GUI=1
# Real-time factor. 1 is real time. 2 runs the physics twice as fast.
SIM_SPEED_FACTOR=1

# World origin. QGC and the mission planner use these coordinates.
HOME_LAT=38.9869
HOME_LON=-76.9426
HOME_ALT=20

# --------------------------------------------------------------------- the modules
# ROS_STACK picks a directory from modules/ros/stacks/. See docs/development.md.
ROS_STACK=baseline
ROS_DOMAIN_ID=42

# DS_CONFIG picks a deepstream-app config from modules/perception/configs/.
DS_CONFIG=camera_detector.txt

# Which camera perception runs on, and which one detections are localized
# from. nadir looks straight down and needs no gimbal pointing. Use gimbal
# once you are commanding the gimbal yourself.
PERCEPTION_CAMERA=nadir

# ---------------------------------------------------------------------- extra GCS
# Set this to reach a QGroundControl instance outside the compose network, for
# example one that runs on your host or on a second machine. Leave it empty to
# use only the containerized QGC.
HOST_GCS_IP=

# ------------------------------------------------------------- frame alignment
# Two GPS-derived frames disagree by metres, and that offset is a frame
# difference rather than noise. Measure it once against a point whose position
# you know, then every localization is corrected into that frame.
#
# surveyed = where the point truly is. measured = where this pipeline put it.
# In simulation both can simply be written down. Do not use a target you also
# score against: fitting the correction to a scored target measures nothing.
FIDUCIAL_ENABLED=0
FIDUCIAL_SURVEYED_LAT=0.0
FIDUCIAL_SURVEYED_LON=0.0
FIDUCIAL_SURVEYED_ALT=0.0
FIDUCIAL_MEASURED_LAT=0.0
FIDUCIAL_MEASURED_LON=0.0
FIDUCIAL_MEASURED_ALT=0.0
