#!/usr/bin/env bash
# px4sim - one command for the whole stack.
#
#   ./px4sim start        bring everything up
#   ./px4sim stop         shut everything down
#   ./px4sim status       what is running
#
# Run `./px4sim` with no arguments for the full list. Every command works from
# any directory. This script is the front door: the Makefile forwards every
# target to it, and compose alone is not enough, because the scene and the
# scenario are resolved here.
set -euo pipefail

cd "$(dirname "$(readlink -f "$0")")"

DC="docker compose"

# What a vehicle can be asked to capture. The console offers these, and the
# `capture` arm below takes these, so one list answers both.
CAPTURE_KINDS="mosaic vlm fiducial"

BOLD=$'\033[1m'; DIM=$'\033[2m'; GRN=$'\033[32m'; RED=$'\033[31m'; YEL=$'\033[33m'; OFF=$'\033[0m'
say()  { printf '%s==> %s%s\n' "$BOLD" "$*" "$OFF"; }
warn() { printf '%s    %s%s\n' "$YEL" "$*" "$OFF"; }
die()  { printf '%s!!! %s%s\n' "$RED" "$*" "$OFF" >&2; exit 1; }

# What compose.yaml actually declares, read from the file itself. A name here
# that the file does not carry sends a user to a service that cannot start, so
# nothing below is written twice.
compose_services() {
	awk '/^services:/            { inside = 1; next }
	     /^[^[:space:]]/         { inside = 0 }
	     inside && /^  [a-z0-9_-]+:[[:space:]]*$/ { gsub(/[ :]/, ""); print }' compose.yaml
}
COMPOSE_SERVICES=$(compose_services)
has_service() { printf '%s\n' "$COMPOSE_SERVICES" | grep -qx "$1"; }

# The project every container is labelled with, taken from the same file, so
# `docker ps` can be asked for this stack's containers and no other's.
COMPOSE_PROJECT=$(sed -n 's/^name:[[:space:]]*\([a-z0-9_-]\+\).*/\1/p' compose.yaml | head -1)
[ -n "$COMPOSE_PROJECT" ] || die "compose.yaml declares no name. Is the file intact?"

# Every profile, so `stop` and `clean` reach containers that `start` did not
# create. Compose ignores a service whose profile is not selected, which
# otherwise leaves the router and companion containers behind.
ALL_PROFILES=$(sed -n 's/^[[:space:]]*profiles:[[:space:]]*\[\(.*\)\][[:space:]]*$/\1/p' compose.yaml |
	tr -d ' ' | tr ',' '\n' | sort -u | paste -sd, -)
[ -n "$ALL_PROFILES" ] || die "compose.yaml declares no profiles. Is the file intact?"

[ -f .env ] || { warn "No .env yet. Creating it from .env.example."; cp .env.example .env; }

# .env is the configuration. The environment overrides the few names that
# select one run, so `SCENE=forest ./px4sim start` flies another world once
# and changes no file. The list is short on purpose: a shell that already
# exports SCENE must not quietly change what everything else does.
OVERRIDABLE="SCENE SCENARIO UAS_FLEET UAS_STREAMS AIRFRAME COMPOSE_PROFILES
             GZ_GUI SIM_SPEED_FACTOR VIDEO_SCALED_ENCODER"
for name in $OVERRIDABLE; do
	if [ -n "${!name+set}" ]; then
		eval "override_$name=\$$name"
	fi
done
# shellcheck disable=SC1091
set -a; . ./.env; set +a
for name in $OVERRIDABLE; do
	holder="override_$name"
	if [ -n "${!holder+set}" ]; then
		export "$name=${!holder}"
	fi
done

# The ground station's ROS domain. compose.yaml and the offboard entry point
# both default it to 70, and the commands below hand it to `docker exec` as
# ROS_DOMAIN_ID. Unset, that exec gets an empty string, which rmw reads as
# domain 0 -- so `capture` published where nothing listens and reported
# success, because `ros2 topic pub` does not need a subscriber. Defaulted here
# so a .env written before this variable existed still reaches the station.
export GROUND_DOMAIN=${GROUND_DOMAIN:-70}

# Whether the fleet that is flying is the one the file holds. This script
# exports what it reads, so a px4sim that this one runs -- the console, or
# `fly` calling `place` -- finds the file's own value in its environment and
# cannot tell it from a value a person set for one run. So each px4sim says
# which it holds, and the one it runs believes it. `fleet add` and `fleet
# remove` edit the file, and they must not do that while another fleet flies.
if [ -z "${override_UAS_FLEET+set}" ]; then
	export PX4SIM_FLEET_FROM_FILE="${UAS_FLEET:-}"
fi
FLEET_IS_THE_FILE=false
[ "${PX4SIM_FLEET_FROM_FILE:-}" = "${UAS_FLEET:-}" ] && FLEET_IS_THE_FILE=true

# A coordinate in .env is a leftover from before the scene carried it. It
# changes nothing now, and a line that looks live but is not is how a run ends
# up somewhere else.
if grep -qE '^[[:space:]]*(HOME_(LAT|LON|ALT)|FIDUCIAL_SURVEYED_)' .env; then
	warn "Delete the HOME_* and FIDUCIAL_SURVEYED_* lines from .env. The scene"
	warn "and the scenario carry the origin now, and those lines do nothing."
fi

# One vehicle became a fleet. A VEHICLE line still looks live and is not.
if grep -qE '^[[:space:]]*VEHICLE=' .env; then
	warn "Replace the VEHICLE line in .env with UAS_FLEET, which names one model"
	warn "for each vehicle. See .env.example."
fi

# The retired simulator stack. Its services are gone, so a line that names one
# selects nothing and starts nothing, which reads as a stack that came up.
if grep -qE '^[[:space:]]*(ROS_STACK|ROS_DOMAIN_ID|PERCEPTION_CAMERA|DS_CONFIG|LOCALIZATION_MODE|MQTT_|FIDUCIAL_MEASURED_)' .env \
   || grep -qE '^[[:space:]]*COMPOSE_PROFILES=.*(ros|perception)' .env; then
	warn "Your .env still names the retired ros and perception services. The"
	warn "companion (onboard<N>) and the ground station (offboard) replace them."
	warn "Compare it against .env.example."
fi

# What this machine needs to run DeepStream. The release and the ROS
# distribution are fixed -- 7.1 and Humble, what the aircraft runs -- and the
# GPU decides one thing only: whether the TensorRT that release ships can emit
# kernels for this card. Where it cannot, a newer TensorRT goes into the same
# 22.04 image. Left alone, the stack builds no engine and the only symptom is
# video that streams and nothing that is ever detected.
#
# Resolved on every run rather than written into .env, because a value in the
# file is right on the machine it was written on and silently wrong on the next
# one. DS_VERSION in .env still pins a release when a result has to be
# reproduced; ds-select.sh reads it from here. See scripts/ds-select.sh.
ds_resolved=$(./scripts/ds-select.sh) ||
	die "ds-select.sh could not choose a DeepStream release. See the message above."
eval "$ds_resolved"
export DS_VERSION DS_IMAGE DS_TAG ROS_DISTRO DS_CODENAME DS_TRT_VERSION DS_TRT_CUDA DS_REASON

# The world origin and the survey marker come from the scene and the
# scenario, never from .env. SCENE and SCENARIO carry them. Every command
# that reaches compose needs them, so this runs before the command does.
# `scene` calls it again with the new world. See scripts/origin-env.sh.
ORIGIN_FILE=.origin.env
resolve_origin() {
	local scene=${1:-${SCENE:-}} scenario=${2:-${SCENARIO:-}}
	unset HOME_LAT HOME_LON HOME_ALT
	unset FIDUCIAL_ENABLED FIDUCIAL_SURVEYED_LAT FIDUCIAL_SURVEYED_LON FIDUCIAL_SURVEYED_ALT
	eval "$(./scripts/origin-env.sh "$scenario" "$scene")"
	if [ -z "${HOME_LAT:-}" ]; then
		# Nothing to carry, so leave no stale file behind. PX4 then keeps
		# the coordinates the world file declares, which is the origin of
		# that scene. Only a scene that is not built yet lands here.
		rm -f "$ORIGIN_FILE"
		return 0
	fi
	export HOME_LAT HOME_LON HOME_ALT
	export FIDUCIAL_ENABLED
	export FIDUCIAL_SURVEYED_LAT=${FIDUCIAL_SURVEYED_LAT:-0.0}
	export FIDUCIAL_SURVEYED_LON=${FIDUCIAL_SURVEYED_LON:-0.0}
	export FIDUCIAL_SURVEYED_ALT=${FIDUCIAL_SURVEYED_ALT:-0.0}

	# The containers read the origin from this file, which compose names in
	# env_file. Writing it here keeps one source: the scene and the scenario
	# decide, this file only carries the answer across, and `docker compose`
	# on its own gets the same values as the front door.
	cat > "$ORIGIN_FILE" <<-EOF
		# Generated by ./px4sim. Do not edit; edit the scenario or the world.
		# scene=$scene scenario=$scenario
		PX4_HOME_LAT=$HOME_LAT
		PX4_HOME_LON=$HOME_LON
		PX4_HOME_ALT=$HOME_ALT
		FIDUCIAL_ENABLED=$FIDUCIAL_ENABLED
		FIDUCIAL_SURVEYED_LAT=$FIDUCIAL_SURVEYED_LAT
		FIDUCIAL_SURVEYED_LON=$FIDUCIAL_SURVEYED_LON
		FIDUCIAL_SURVEYED_ALT=$FIDUCIAL_SURVEYED_ALT
	EOF
}
resolve_origin

# The fleet decides which routers run. One router for each vehicle, selected by
# the profile of its own name, so a fleet of four starts uas11 to uas14 and
# nothing else. UAS_FLEET is the single place the fleet size is written.
# shellcheck disable=SC1091
. ./scripts/fleet.sh
# shellcheck disable=SC1091
. ./scripts/zoom.sh

# A vehicle is named by its UAS number, 11 upwards. A single digit is its place
# in UAS_FLEET, which is how that line reads, so `1` and `11` both reach the
# first vehicle. Every command that takes one vehicle resolves it here.
vehicle_arg() {
	local given=${1:-$FIRST_UAS} n
	case "$given" in
	'' | *[!0-9]*) die "'$given' is not a vehicle number. This fleet is uas$FIRST_UAS to uas$LAST_UAS." ;;
	esac
	n=$given
	if [ "$n" -le "$UAS_COUNT" ]; then n=$((UAS_BASE + n)); fi
	if [ "$n" -lt "$FIRST_UAS" ] || [ "$n" -gt "$LAST_UAS" ]; then
		die "No uas$n here. UAS_FLEET holds $UAS_COUNT vehicles, uas$FIRST_UAS to uas$LAST_UAS."
	fi
	echo "$n"
}

# Two ways a fleet fails quietly. An entry that names no known mark spawns no
# vehicle, and a vehicle that compose defines no companion for flies with a
# router that nothing listens behind.
for n in $(fleet_numbers); do
	if [ -z "$(mark_of "$n")" ]; then
		warn "UAS_FLEET names '$(model_of "$n")' for uas$n, which is neither a v2 nor a v3."
		warn "The simulator, the companion and the ground station all refuse it."
	elif [ ! -d "modules/sim/scenes/models/$(model_of "$n")" ]; then
		warn "uas$n names model '$(model_of "$n")', which is not in modules/sim/scenes/models."
	fi
	if ! has_service "uas$n"; then
		warn "compose.yaml defines no uas$n. This stack numbers its vehicles"
		warn "uas$FIRST_UAS to uas19, so UAS_FLEET holds nine entries at the most."
	elif ! has_service "onboard$n"; then
		warn "compose.yaml defines no onboard$n, so uas$n would run a router with"
		warn "nothing behind it: no ROS topics, no detections, no ground picture."
	fi
done

# QGroundControl shows one stream, and which mount that is depends on the
# airframe. compose defaults it to uas11's v3 name, so derive it here instead
# and leave a value from .env or the environment alone.
QGC_VIDEO_URL_FOLLOWS_FLEET=false
if [ -z "${QGC_VIDEO_URL:-}" ] && [ -n "$(gimbal_stream "$FIRST_UAS")" ]; then
	export QGC_VIDEO_URL="rtsp://video-router:8554/$(gimbal_stream "$FIRST_UAS")"
	QGC_VIDEO_URL_FOLLOWS_FLEET=true
fi

# Every vehicle needs its router AND its companion. Without the onboard
# profile the routers start, PX4 pushes into them, and no ROS stack ever
# listens, which reads as a healthy stack with no topics.
fleet_profiles() {
	local list="" n
	for n in $(fleet_numbers); do
		if has_service "uas$n";     then list="$list,uas$n"; fi
		if has_service "onboard$n"; then list="$list,onboard$n"; fi
	done
	echo "${list#,}"
}
add_fleet_profiles() {
	local extra
	extra=$(fleet_profiles)
	if [ -n "${COMPOSE_PROFILES:-}" ]; then
		export COMPOSE_PROFILES="$COMPOSE_PROFILES,$extra"
	else
		export COMPOSE_PROFILES="$extra"
	fi
}

# Reload the world, and everything that reads it. Both `scene` and `place`
# need this, and a caller that recreates the simulator alone leaves a stack
# that reports nothing wrong and answers with stale data.
#
# A pipeline opens its camera ONCE, and the RTSP stream it was reading does not
# survive a new simulator, so anything left running afterwards holds a pipeline
# that will never see another frame. The symptom is not an error: the panel
# keeps painting the last frame it got, so the operator sees a picture that
# stopped rather than a picture that failed. Their entry points wait for the
# camera on the way back up.
#
# The companions also link the scene's terrain surface and compute the scene's
# geoid height at start up, so one left running against a new scene casts every
# ray at the old ground and reports a position that is confidently wrong.
#
# ground-router borrows the ground station's network namespace
# (network_mode: service:offboard), so recreating offboard without it leaves
# the router attached to a namespace that no longer exists. It keeps running
# and reports nothing wrong, and MAVLink simply never reaches the ground again:
# no fix, so no frame tree, so the terrain, the footprint, the live view and
# every scoring layer sit silent while their nodes look healthy.
reload_world() {
	local reloading
	add_fleet_profiles
	reloading="sim $(picture_consumers)"
	has_service ground-router && reloading="$reloading ground-router"
	# shellcheck disable=SC2086
	$DC up -d --force-recreate $reloading >/dev/null 2>&1
}

# What carries the picture. A pipeline opens its camera ONCE, so recreating
# either of these leaves every reader holding a pipeline that will never see
# another frame. The reader reports nothing wrong: the panel keeps painting the
# last frame it got, so the operator sees a picture that stopped rather than a
# picture that failed.
PICTURE_SOURCES="sim video-router"

# Every container that opens a camera: each vehicle's companion, and the ground
# station, which reads the low rate streams for its own preview.
picture_consumers() {
	local number list=""
	for number in $(fleet_numbers); do
		has_service "onboard$number" && list="$list onboard$number"
	done
	has_service offboard && list="$list offboard"
	echo "${list# }"
}

# Which services join another's network namespace, read from the compose file
# so a new one is never missed.
namespace_borrowers() {
	awk -v owner="service:$1" '
		/^  [a-z0-9_-]+:[[:space:]]*$/ { service = $1; sub(/:$/, "", service) }
		$1 == "network_mode:" { mode = $2; gsub(/"/, "", mode)
		                        if (mode == owner) print service }' compose.yaml
}

# A container that loses a host port at start keeps its place in the project,
# and the next `up` can bring it back with no network endpoint at all: no
# address on the network it was told to join, no name the other services can
# resolve, and none of the ports it publishes. Nothing about it reads as
# broken. Compose says running, `docker ps` says Up, and its own log says it is
# listening, because inside the container it is. Everything that needs it waits
# forever instead, which is a silence, not an error.
#
# So this reads the endpoint rather than the container: the network it was told
# to join against the one it holds, and the ports it asked to publish against
# the ones it got. A service that borrows another's namespace has no endpoint
# of its own by design, and is left alone. See network_mode in compose.yaml.
wedged_services() {
	local names name fields service netmode nets bindings ports
	names=$(docker ps --filter "label=com.docker.compose.project=$COMPOSE_PROJECT" \
	                  --filter status=running --format '{{.Names}}' 2>/dev/null) || return 0
	for name in $names; do
		fields=$(docker inspect "$name" --format \
			'{{index .Config.Labels "com.docker.compose.service"}} {{.HostConfig.NetworkMode}} {{len .NetworkSettings.Networks}} {{len .HostConfig.PortBindings}} {{len .NetworkSettings.Ports}}' \
			2>/dev/null) || continue
		# shellcheck disable=SC2086
		set -- $fields
		[ $# -eq 5 ] || continue
		service=$1 netmode=$2 nets=$3 bindings=$4 ports=$5
		case "$netmode" in container:* | host | none) continue ;; esac
		if [ "$nets" -eq 0 ]; then
			echo "$service joined no network: no address on $netmode, and no name to resolve."
		elif [ "$bindings" -gt 0 ] && [ "$ports" -eq 0 ]; then
			echo "$service published none of the $bindings host ports it asks for."
		fi
	done
}

need_sources() {
	[ -d src/PX4-Autopilot ] || die "No PX4 source. Run: ./px4sim setup"
}

# Short names for the services whose compose name is longer, and for the ones
# there is one of for each vehicle. Every command that takes a service resolves
# it here, so one name works everywhere.
service_name() {
	case "$1" in
	router)  echo "uas$FIRST_UAS" ;;
	onboard) echo "onboard$FIRST_UAS" ;;
	ground)  echo offboard ;;
	video)   echo video-router ;;
	*) echo "$1" ;;
	esac
}

# The same names for a command that takes a list: `logs ground`, `build onboard`.
# The answer lands in SERVICES, because a function cannot return an array.
resolve_services() {
	local name
	SERVICES=()
	for name in "$@"; do SERVICES+=("$(service_name "$name")"); done
}

# Open a shell in a service. Probes quietly first: attaching to a missing
# shell prints a raw OCI error before anything of ours can explain it.
#
# Every profile is selected here. A service whose profile is not selected is
# not in the project at all, so the probe below would report a running
# companion or router as stopped.
enter_service() {
	local svc
	svc=$(service_name "$1")
	has_service "$svc" || die "compose.yaml has no service named '$svc'. ./px4sim status lists them."
	COMPOSE_PROFILES="$ALL_PROFILES" $DC ps --status running --services 2>/dev/null | grep -qx "$svc" \
		|| die "$svc is not running. Run: ./px4sim start"
	shift
	for candidate in bash sh; do
		if COMPOSE_PROFILES="$ALL_PROFILES" $DC exec -T "$svc" "$candidate" -c 'exit 0' >/dev/null 2>&1; then
			# With arguments this runs one command and returns its status, so
			# looking inside a container needs no second way of doing it.
			[ $# -gt 0 ] && exec env COMPOSE_PROFILES="$ALL_PROFILES" \
				$DC exec -T "$svc" "$candidate" -c "$*"
			exec env COMPOSE_PROFILES="$ALL_PROFILES" $DC exec "$svc" "$candidate"
		fi
	done
	die "$svc has no shell. That image ships one binary and nothing else.
    Look at it from outside instead:
      ./px4sim logs $svc
      docker inspect px4simstack-$svc-1"
}

usage() {
	cat <<EOF
${BOLD}px4sim${OFF} - PX4, Gazebo and the Chimera flight code in containers

  ${BOLD}Getting started${OFF}
    doctor              Check the host: driver, docker, GPU runtime, X11, disk
    setup               Clone PX4 and build the scenes (a few minutes)
    build               Build the images (about 20 minutes the first time)

  ${BOLD}Every day${OFF}
    start [profiles]    Start everything. Default profiles: ${COMPOSE_PROFILES:-none}
    core                Start the vehicles and QGC, with no ground station
    stop                Stop and remove the containers. Volumes stay.
    restart [service]   Restart one service, or all of them
    status              What is running, and the addresses to use
    ui                  The same in a console, with a key for every command
    fleet               Every vehicle: model, address, ports, domain, streams
    fleet add [model]   Fly one more vehicle. Default: another of the last one
    fleet remove [N]    Retire one vehicle. Default: the last of the fleet
    logs [opts] [svc]   Follow the logs. \`logs --since 5m sim\` reads back.
    console             uas${FIRST_UAS}'s PX4 pxh> prompt. Detach with Ctrl-P Ctrl-Q
    px4 [N] <command>   One PX4 command on one vehicle: px4 ${LAST_UAS} commander status

  ${BOLD}Get inside a container${OFF}
    sim                 PX4, Gazebo and the camera encoders
    qgc                 QGroundControl
    router [N]          a vehicle's mavlink-router. Default uas${FIRST_UAS}
    onboard [N]         a vehicle's companion computer. Default uas${FIRST_UAS}
    ground              the ground station
    shell <svc> [cmd]   any other service, or one command inside it

  ${BOLD}Look at the data${OFF}
    streams             Which video streams are live right now
    view [N|stream]     Play a stream. Default: uas${FIRST_UAS}'s gimbal camera
    topics [N]          List a vehicle's ROS topics. Default: uas${FIRST_UAS}
    layout              Where the Foxglove layout lives, and how to load it

  ${BOLD}Scenes and targets${OFF}
    scene <name>        Switch the world and restart the simulator
    scenario <name>     Switch the targets and reload what scores them
    scenario            Place this scenario's targets again, with no restart
    origin              The coordinates this scene and scenario fly at
    fiducial [e] [n]    Stand the survey marker this far off its survey
    capture <N> [kind]  Ask for a mosaic, vlm or fiducial capture
    reset               Remove the targets from the running world
    place               Put the fleet back upright at its start
    fly <N> [m]         Respawn, then get that vehicle airborne
    genscene <args>     Build a world from map data. Try: genscene --help
                        ${DIM}all runs create / detect / edit (browser on :8090) / build${OFF}

  ${BOLD}Housekeeping${OFF}
    check               Validate the compose file and lint the docs
    verify [stage]      Run the verification stages. \`verify help\` lists them.
    state [--watch]     Every reading the console draws, as JSON
    uas <N> <command>   Fly one vehicle and read its nodes: status, arm,
                        takeoff [m], land, gimbal <pitch>
    probe <N> [topic]   What that vehicle's ROS graph carries right now
    foxglove <N>        What Foxglove is offered on that bridge, over the
                        protocol Foxglove speaks. \`foxglove ground\` too.
    snap <stream>       Save one frame of a live stream to look at
    zoom <N> <preset>   Set a v3 lens: narrow, mid or wide, and read it back
    clean               Remove containers, networks and volumes
    clean-src           Delete the cloned upstream sources in ./src
    nuke                clean and clean-src together

  Current: scene ${SCENE:-?}, scenario ${SCENARIO:-?}, fleet ${UAS_FLEET:-?}
           origin ${HOME_LAT:-?}, ${HOME_LON:-?}
EOF
}

endpoints() {
	echo
	printf '  %sFleet%s   %s\n' "$BOLD" "$OFF" "${DIM}./px4sim fleet prints the stream names too${OFF}"
	local n prefix=${SIMNET_PREFIX:-10.200.142}
	for n in $(fleet_numbers); do
		printf '    uas%-3s %-12s %s.2%s   sysid %s   domain %s   tcp %s   udp %s\n' \
			"$n" "$(model_of "$n")" "$prefix" "$n" "$n" "$(uas_domain "$n")" \
			"$(uas_tcp_port "$n")" "$(uas_gcs_port "$n")"
	done
	cat <<EOF

  ${BOLD}MAVLink${OFF}     udp://<gcs>:$(uas_gcs_port "$FIRST_UAS") upwards   the ground station endpoint, from GCS_ADDRESS
              udp://<qgc>:14550         QGroundControl autoconnect, from QGC_ADDRESS
              udp://127.0.0.1:14402     the 5g_drone companion, inside the vehicle
              tcp://localhost:$(uas_tcp_port "$FIRST_UAS") upwards   MAVSDK, pymavlink
  ${BOLD}Video${OFF}       rtsp://localhost:${RTSP_HOST_PORT:-8554}/rgb<N>      v3 gimbal camera, 1920x1080
              rtsp://localhost:${RTSP_HOST_PORT:-8554}/pilot<N>    v3 down camera, v2 gimbal camera, 1920x1080
              rtsp://localhost:${RTSP_HOST_PORT:-8554}/thermal<N>  640x512
              ${DIM}Append l for the low-rate stream: rgbl<N>, pilotl<N>, thermall<N>, all 640x360 except thermal.${OFF}
              http://localhost:8889/$(gimbal_stream "$FIRST_UAS")       ${DIM}(WebRTC, browser)${OFF}
  ${BOLD}Foxglove${OFF}    ws://localhost:8765       the ground station, every vehicle
              ws://localhost:$(uas_foxglove_port "$FIRST_UAS")       uas$FIRST_UAS's own bridge, ${DIM}8760 + N, for a vehicle that has a companion${OFF}

EOF
}

# The stack as one fact for each line, for a tool that reads rather than reads
# out. scripts/state.py takes this on standard input, so the console draws the
# numbers this script works out and never works out its own.
fleet_facts() {
	local n companion
	cat <<-EOF
		scene=${SCENE:-}
		scenario=${SCENARIO:-}
		home_lat=${HOME_LAT:-}
		home_lon=${HOME_LON:-}
		home_alt=${HOME_ALT:-}
		fiducial=${FIDUCIAL_ENABLED:-0}
		fiducial_lat=${FIDUCIAL_SURVEYED_LAT:-}
		fiducial_lon=${FIDUCIAL_SURVEYED_LON:-}
		fiducial_alt=${FIDUCIAL_SURVEYED_ALT:-}
		profiles=${COMPOSE_PROFILES:-}
		compose=$DC
		ground_domain=$GROUND_DOMAIN
		ground_foxglove=8765
		mediamtx=${MEDIAMTX_API:-http://localhost:9997}
		zoom_presets=$(zoom_presets_widest_first | paste -sd, -)
		capture_kinds=$(echo "$CAPTURE_KINDS" | tr ' ' ',')
		models=$(fleet_models | paste -sd, -)
		scenarios=$(scenario_names | paste -sd, -)
		declared=$(printf '%s\n' "$COMPOSE_SERVICES" | paste -sd, -)
		expected=$($DC config --services 2>/dev/null | paste -sd, -)
	EOF
	for n in $(fleet_numbers); do
		companion=$(has_service "onboard$n" && echo "onboard$n" || true)
		printf 'vehicle n=%s sysid=%s model=%s mark=%s domain=%s tcp=%s gcs=%s foxglove=%s address=%s router=uas%s companion=%s gimbal=%s streams=%s zoom=%s\n' \
			"$n" "$n" "$(model_of "$n")" "$(mark_of "$n")" "$(uas_domain "$n")" \
			"$(uas_tcp_port "$n")" "$(uas_gcs_port "$n")" "$(uas_foxglove_port "$n")" \
			"$(uas_address "$n")" "$n" "$companion" "$(gimbal_stream "$n")" \
			"$(streams_of "$n" | tr ' ' ',' | sed 's/,$//')" \
			"$(zoom_preset_of_slot $((n - UAS_BASE - 1)) || true)"
	done
}

# Every airframe this simulator flies, from the model directories themselves.
# The scene meshes live beside them, so the mark decides which is an airframe,
# the way mark_of reads it.
fleet_models() {
	local path name
	for path in modules/sim/scenes/models/*/; do
		name=${path%/}
		name=${name##*/}
		case "$name" in *_v2 | *_v3) echo "$name" ;; esac
	done
}

# Every scenario this simulator can place, from the scenario files themselves.
# `scenario` takes a name from this list and the console offers it, so a name
# with no file behind it is caught here and not in a world with no targets.
scenario_names() {
	local path name
	for path in modules/sim/scenes/scenarios/*.yaml; do
		[ -f "$path" ] || continue
		name=${path##*/}
		echo "${name%.yaml}"
	done
}

# Stop before a scenario that does not exist. The simulator only warns about
# one, and the run then flies a world with no targets in it, which reads as a
# detector that finds nothing rather than as a name that was mistyped.
have_scenario() {
	[ -f "modules/sim/scenes/scenarios/$1.yaml" ] \
		|| die "No scenario named '$1'. Try: $(scenario_names | paste -sd' ' -)"
}

# Put the fleet back into .env and leave every other line as it was.
fleet_write() {
	if grep -q '^[[:space:]]*UAS_FLEET=' .env; then
		sed -i "s|^[[:space:]]*UAS_FLEET=.*|UAS_FLEET=\"$1\"|" .env
	else
		printf 'UAS_FLEET="%s"\n' "$1" >> .env
	fi
}

# Add or retire one vehicle, then bring the stack to the new fleet.
#
# The place in UAS_FLEET is the vehicle number, so a vehicle taken from
# anywhere but the end moves every vehicle after it down one: other frames,
# ports, ROS domains and stream names. --renumber says that is intended.
fleet_edit() {
	local action=$1; shift
	local renumber=false argument="" word
	for word in "$@"; do
		case "$word" in
		--renumber) renumber=true ;;
		-*)         die "fleet $action does not take '$word'." ;;
		*)          argument=$word ;;
		esac
	done
	[ "$FLEET_IS_THE_FILE" = true ] \
		|| die "UAS_FLEET is set in this shell, and it wins over .env, so a change
    to the file would not be what flies. Run: unset UAS_FLEET"

	local models=("${FLEET[@]}") model retired="" n slot name
	case "$action" in
	add)
		model=${argument:-${models[-1]}}
		local airframes
		airframes=$(fleet_models)
		case $'\n'"$airframes"$'\n' in
		*$'\n'"$model"$'\n'*) ;;
		*) die "No airframe '$model'. This simulator flies: $(echo $airframes)" ;;
		esac
		[ "${#models[@]}" -lt 9 ] \
			|| die "This simulator numbers its vehicles uas11 to uas19, so nine is the whole fleet."
		models+=("$model")
		say "adding uas$((UAS_BASE + ${#models[@]})), a $model"
		;;
	remove)
		[ "${#models[@]}" -gt 1 ] \
			|| die "One vehicle is the smallest fleet. To stop flying: ./px4sim stop"
		n=$(vehicle_arg "${argument:-$LAST_UAS}")
		if [ "$n" -ne "$LAST_UAS" ] && [ "$renumber" != true ]; then
			warn "uas$n is not the last vehicle. Taking it out moves uas$((n + 1)) to uas$n and"
			warn "every vehicle after it down one, which gives each of them other frames,"
			warn "ports, ROS domains and stream names. Say that this is intended:"
			warn "  ./px4sim fleet remove $n --renumber"
			die "nothing was changed"
		fi
		say "retiring uas$n, a $(model_of "$n")"
		slot=$((n - UAS_BASE - 1))
		unset 'models[slot]'
		models=("${models[@]}")
		# The fleet is one shorter, so the highest number goes, whichever
		# vehicle was taken out of the list.
		retired=$LAST_UAS
		;;
	esac

	fleet_write "${models[*]}"
	export UAS_FLEET="${models[*]}"
	export PX4SIM_FLEET_FROM_FILE="$UAS_FLEET"
	# Every number below follows the new fleet, from the one table that holds them.
	# shellcheck disable=SC1091
	. ./scripts/fleet.sh
	if [ "$QGC_VIDEO_URL_FOLLOWS_FLEET" = true ] && [ -n "$(gimbal_stream "$FIRST_UAS")" ]; then
		export QGC_VIDEO_URL="rtsp://video-router:8554/$(gimbal_stream "$FIRST_UAS")"
	fi
	say "UAS_FLEET is now: $UAS_FLEET"

	if [ -z "$(COMPOSE_PROFILES="$ALL_PROFILES" $DC ps --status running -q 2>/dev/null)" ]; then
		echo "  Nothing is running, so the new fleet flies at the next start:"
		echo "    ./px4sim start"
		return 0
	fi

	if [ -n "$retired" ]; then
		local gone=()
		for name in "uas$retired" "onboard$retired"; do
			has_service "$name" && gone+=("$name")
		done
		if [ ${#gone[@]} -gt 0 ]; then
			COMPOSE_PROFILES="$ALL_PROFILES" $DC rm -sf "${gone[@]}" >/dev/null 2>&1
			say "removed ${gone[*]}, which the fleet no longer holds"
		fi
	fi

	# The simulator spawns one PX4 and its cameras for each entry, and the
	# ground station holds one MAVROS for each vehicle, so both carry UAS_FLEET
	# and compose recreates them here. The world reloads with them.
	add_fleet_profiles
	say "reloading the world. Every vehicle respawns, which takes a moment."
	$DC up -d
	echo
	$DC ps --format 'table {{.Service}}\t{{.Status}}'
	say "Wait for 'Ready for takeoff' in ./px4sim logs sim"
}

# bash reads a script as it runs, so editing this file during a long command
# makes it resume at a shifted offset and fail on a line that is now half of
# another. A function is parsed in full before any of it runs, so the command
# below survives an edit to this file while it works.
main() {
cmd=${1:-help}
[ $# -gt 0 ] && shift || true

case "$cmd" in

# The fleet profiles carry a router and a companion for each vehicle, and
# so the ports those publish. Without them preflight checks the ports of a
# stack smaller than the one `start` would raise.
doctor)   add_fleet_profiles; ./scripts/preflight.sh ;;
setup)    ./scripts/bootstrap.sh "$@" ;;

build)
	# The fleet profiles, or compose builds only what the named profiles hold
	# and the companion image is never built. `build onboard` and `build
	# router` build the image every vehicle shares.
	add_fleet_profiles
	./scripts/x11-allow.sh
	resolve_services "$@"

	# ros-base is what onboard and offboard are made of, and compose has no way
	# to order one build before another, so it is built here when either of
	# them is. Named on its own it is built on its own, which is how to warm
	# the cache before a day's work.
	needs_base=false
	[ ${#SERVICES[@]} -eq 0 ] && needs_base=true
	for svc in "${SERVICES[@]}"; do
		case "$svc" in onboard* | offboard | ros-base) needs_base=true ;; esac
	done
	if [ "$needs_base" = true ]; then
		COMPOSE_PROFILES=base $DC build ros-base
	fi

	# Everything but the base. Asking compose to build it again here would be
	# a second no-op pass over the largest image in the stack.
	REMAINING=()
	for svc in "${SERVICES[@]}"; do
		[ "$svc" = ros-base ] || REMAINING+=("$svc")
	done
	if [ ${#SERVICES[@]} -eq 0 ]; then
		$DC build
	elif [ ${#REMAINING[@]} -gt 0 ]; then
		$DC build "${REMAINING[@]}"
	fi
	;;

x11)      ./scripts/x11-allow.sh ;;

start|up|core)
	# A profile list can be given: ./px4sim start offboard,xrce
	# `core` drops every named profile. The fleet is added below either way,
	# so it is the vehicles, the transport and QGC, with no ground station.
	[ "$cmd" = core ] && export COMPOSE_PROFILES=""
	[ $# -gt 0 ] && export COMPOSE_PROFILES="$1"
	add_fleet_profiles
	need_sources
	./scripts/x11-allow.sh
	say "Starting: $COMPOSE_PROFILES"
	echo "  fleet ${UAS_FLEET:-?}"
	if [ -n "${HOME_LAT:-}" ]; then
		echo "  scene ${SCENE:-?}, scenario ${SCENARIO:-?}, origin $HOME_LAT, $HOME_LON"
	else
		warn "No origin for scene '${SCENE:-unset}', scenario '${SCENARIO:-unset}'."
		warn "PX4 will fly the coordinates inside the world file. ./px4sim origin"
	fi
	$DC up -d
	echo
	$DC ps --format 'table {{.Service}}\t{{.Status}}'
	endpoints
	if [ ! -x src/PX4-Autopilot/build/px4_sitl_default/bin/px4 ]; then
		warn "PX4 has not been built yet. The first start compiles it, which"
		warn "takes 10 to 20 minutes. Watch it with: ./px4sim logs sim"
	fi
	;;

stop|down)
	say "Stopping everything"
	COMPOSE_PROFILES="$ALL_PROFILES" $DC down --remove-orphans

	# Fast DDS keeps its shared memory in /dev/shm, and these containers share
	# the host's, so a segment outlives the container that made it. They pile
	# up a few hundred at a time until a new participant cannot lock a port and
	# the ground station quietly stops hearing anything. Only the ones nobody
	# has open are removed, so another stack on this machine is left alone.
	leaked=0
	for segment in /dev/shm/fastrtps_*; do
		[ -e "$segment" ] || continue
		fuser -s "$segment" 2>/dev/null && continue
		rm -f "$segment" && leaked=$((leaked + 1))
	done
	[ "$leaked" -gt 0 ] && echo "  released $leaked shared memory segments"
	;;

restart)
	# Recreate, not restart. `docker compose restart` starts the same container
	# again, so a service restarted after `./px4sim build` keeps running the
	# image it was created from and the change looks like it did nothing.
	#
	# A service that lends its network namespace takes its borrowers with it: a
	# recreated container gets a new namespace and the old one is left holding
	# nothing but loopback, which reads as a running container that hears
	# nobody. See network_mode in compose.yaml.
	#
	# A service that carries the picture takes every camera reader with it, for
	# the same reason and with the same silence. See PICTURE_SOURCES.
	resolve_services "$@"
	add_fleet_profiles
	for source in "${SERVICES[@]}"; do
		case " $PICTURE_SOURCES " in *" $source "*) ;; *) continue ;; esac
		for reader in $(picture_consumers); do
			case " ${SERVICES[*]} " in
			*" $reader "*) ;;
			*) SERVICES+=("$reader") ;;
			esac
		done
	done
	for owner in "${SERVICES[@]}"; do
		for borrower in $(namespace_borrowers "$owner"); do
			case " ${SERVICES[*]} " in
			*" $borrower "*) ;;
			*) SERVICES+=("$borrower") ;;
			esac
		done
	done
	$DC up -d --force-recreate "${SERVICES[@]}"
	;;

status|ps)
	COMPOSE_PROFILES="$ALL_PROFILES" $DC ps \
		--format 'table {{.Service}}\t{{.Status}}\t{{.Ports}}'
	# Up is not the same as reachable, and the table above only knows Up.
	wedged=$(wedged_services)
	if [ -n "$wedged" ]; then
		echo
		warn "Running, and reachable by nothing:"
		printf '%s\n' "$wedged" | while read -r line; do warn "  $line"; done
		warn "Starting these again reuses the endpoint they have. Free whatever"
		warn "holds the port (./px4sim doctor names it), then recreate them:"
		warn "  ./px4sim stop && ./px4sim start"
	fi
	endpoints
	;;

ui|tui)
	# The console. It draws `state` and runs this script for everything it does,
	# so it can start nothing that the prompt cannot. The profiles are added by
	# the commands it runs, and adding them here would name each one twice.
	#
	# It keeps only what a person set for this run. This script exports what it
	# reads from .env, and the console outlives that reading: every command it
	# runs would then fly the fleet and the scene as they were when it started,
	# and `fleet add` from inside it would change a file that nothing reads.
	for name in $OVERRIDABLE; do
		holder="override_$name"
		[ -n "${!holder+set}" ] || unset "$name"
	done
	exec python3 scripts/tui.py "$@"
	;;

state)
	# Every reading the console draws, as JSON. `--watch` keeps them coming, one
	# object for each line. The readings come from the container engine, the
	# video router API and MAVLink itself, never from a log message.
	add_fleet_profiles
	fleet_facts | COMPOSE_PROFILES="$ALL_PROFILES" python3 scripts/state.py "$@"
	;;

logs)
	# Any leading option goes to `docker compose logs`, so one command reads a
	# log live or reads back over it: `./px4sim logs --since 5m onboard11`.
	# Naming an option replaces the follow, because a command that follows
	# cannot be read back from.
	OPTIONS=()
	while [ $# -gt 0 ]; do
		case "$1" in
		-*) OPTIONS+=("$1"); shift
		    case "${1:-}" in -* | '') ;; *) OPTIONS+=("$1"); shift ;; esac ;;
		*)  break ;;
		esac
	done
	[ ${#OPTIONS[@]} -eq 0 ] && OPTIONS=(-f --tail=100)
	resolve_services "$@"
	COMPOSE_PROFILES="$ALL_PROFILES" $DC logs "${OPTIONS[@]}" "${SERVICES[@]}"
	;;

console)
	# uas11 alone keeps a prompt: the sim entrypoint runs it in the
	# foreground, which makes it the container's own terminal, and starts
	# every other vehicle with -d. `px4` below reaches those.
	id=$($DC ps -q sim) || true
	[ -n "${id:-}" ] || die "The sim container is not running. Run: ./px4sim start"
	say "Attaching to uas$FIRST_UAS's pxh>. Detach with Ctrl-P Ctrl-Q, not Ctrl-C."
	echo "  Every other vehicle runs headless. Send one a command with:"
	echo "    ./px4sim px4 $LAST_UAS commander status"
	docker attach "$id"
	;;

px4)
	# One PX4 command on one vehicle. The px4-<module> client reaches the
	# running instance over /tmp/px4-sock-<instance>, and PX4 sets
	# MAV_SYS_ID to the instance plus one, so the instance is the UAS number
	# minus one. `--instance` has to come first: PX4 reads it from argv[1].
	n=$FIRST_UAS
	case "${1:-}" in [0-9] | [0-9][0-9]) n=$(vehicle_arg "$1"); shift ;; esac
	[ $# -gt 0 ] || die "Give a PX4 command. Try: ./px4sim px4 $n commander status"
	module=$1; shift
	$DC exec sim "/px4/build/px4_sitl_default/bin/px4-$module" \
		--instance $((n - 1)) "$@"
	;;

shell|sh)          enter_service "${1:-sim}" "${@:2}" ;;
sim|qgc|ground)    enter_service "$cmd" "$@" ;;
router)            n=$(vehicle_arg "${1:-}"); shift || true; enter_service "uas$n" "$@" ;;
onboard)           n=$(vehicle_arg "${1:-}"); shift || true; enter_service "onboard$n" "$@" ;;

streams)
	say "Video paths"
	./scripts/list-streams.py "${MEDIAMTX_API:-http://localhost:9997}"
	echo
	echo "  Play one with:  ./px4sim view $(gimbal_stream "$FIRST_UAS")"
	;;

view)
	# A number plays that vehicle's gimbal camera, which is the one a v2 and
	# a v3 both carry and the one the detector reads. A name plays itself.
	case "${1:-}" in
	'' | [0-9] | [0-9][0-9])
		n=$(vehicle_arg "${1:-}")
		stream=$(gimbal_stream "$n")
		[ -n "$stream" ] || die "uas$n names no airframe this stack knows, so no stream name follows from it."
		;;
	*) stream=$1 ;;
	esac
	# Warn rather than stop: mediamtx serves whatever publishes to it, and a
	# name of one's own is a fair thing to try.
	served=$(for n in $(fleet_numbers); do streams_of "$n"; done | tr '\n' ' ')
	case " $served " in
	*" $stream "*) ;;
	*) warn "No vehicle in this fleet serves '$stream'. ./px4sim fleet lists what each one does." ;;
	esac
	url="rtsp://127.0.0.1:${RTSP_HOST_PORT:-8554}/$stream"
	command -v ffplay >/dev/null || die "ffplay is not installed. Run: sudo apt install ffmpeg"
	say "Playing $url   (close the window or press q)"
	# Force TCP and drop every buffer we can. Without -rtsp_transport tcp a
	# client can pick UDP, which does not survive docker's NAT.
	exec ffplay -hide_banner -loglevel warning \
		-rtsp_transport tcp -fflags nobuffer -flags low_delay \
		-avioflags direct -probesize 32 -analyzeduration 0 \
		-window_title "$stream" "$url"
	;;

topics)
	# A vehicle holds ROS domain 60 + N and its companion sources the
	# workspace in its entry point, which `exec` does not run. So both are
	# given here. The ground station is domain $GROUND_DOMAIN in the offboard container.
	n=$(vehicle_arg "${1:-}")
	has_service "onboard$n" || die "compose.yaml defines no onboard$n, so uas$n has no ROS stack."
	COMPOSE_PROFILES="$ALL_PROFILES" $DC exec -e ROS_DOMAIN_ID=$((60 + n)) "onboard$n" bash -lc \
		'. /opt/ros/$ROS_DISTRO/setup.bash; . /home/user/ros2_ws/install/setup.bash; ros2 topic list' \
		|| die "onboard$n did not answer. Is it running?  ./px4sim status"
	;;

layout)
	f="${ROS2_WS_DIR:-../ros2_ws}/src/5g_drone/config/foxglove/chimera_sim.json"
	say "Foxglove layout"
	echo "  $(readlink -f "$f" 2>/dev/null || echo "$f")"
	echo
	echo "  1. Open Foxglove, desktop or https://app.foxglove.dev"
	echo "  2. Connect to ws://localhost:8765 for the ground station, which holds"
	echo "     every vehicle, or to one vehicle's own bridge:"
	for n in $(fleet_numbers); do
		if has_service "onboard$n"; then
			echo "       uas$n  ws://localhost:$((8760 + n))"
		fi
	done
	echo "  3. Layout, then Import from file, and pick the file above"
	echo
	echo "  It draws each vehicle's camera with its detection boxes, the ground"
	echo "  the camera covers, the live imagery laid on the terrain, the map,"
	echo "  and the scoring verdicts."
	;;

scene)
	# No name restarts the sim with the scene already in .env, which is how
	# a new UAS_FLEET or AIRFRAME reaches the world.
	name=${1:-${SCENE:-}}
	[ -n "$name" ] || die "Give a scene name. Try: recon_field, forest, baylands, walls"
	say "Switching to scene '$name'"
	# The new world brings its own origin, so resolve it again before the
	# sim starts. Without this the vehicle would fly the old coordinates.
	export SCENE="$name"
	resolve_origin "$SCENE"
	reload_world
	echo "  scene $SCENE   origin ${HOME_LAT:-from the world file}"
	say "Wait for 'Ready for takeoff' in ./px4sim logs sim"
	;;

origin)
	say "Origin for scene '${SCENE:-unset}', scenario '${SCENARIO:-unset}'"
	if [ -z "${HOME_LAT:-}" ]; then
		warn "No origin found. PX4 will fly the coordinates inside the world"
		warn "file. Neither the scenario (home_lat, home_lon, home_alt) nor"
		warn "the world (<spherical_coordinates>) gave one, so check SCENE"
		warn "and SCENARIO in .env, or build the scene: ./px4sim genscene --help"
		exit 0
	fi
	echo "  home      $HOME_LAT, $HOME_LON, $HOME_ALT m"
	if [ "${FIDUCIAL_ENABLED:-0}" = 1 ]; then
		echo "  fiducial  $FIDUCIAL_SURVEYED_LAT, $FIDUCIAL_SURVEYED_LON, $FIDUCIAL_SURVEYED_ALT m surveyed"
	else
		echo "  fiducial  off. This scenario carries no survey marker."
	fi
	echo
	echo "${DIM}  These come from the scene and the scenario, not from .env.${OFF}"
	;;

endpoints|urls) endpoints ;;

fleet)
	case "${1:-}" in
	add | remove) fleet_edit "$@"; exit 0 ;;
	'') ;;
	*) die "fleet takes 'add [model]' or 'remove [N]', or nothing to print the fleet." ;;
	esac
	# The whole map for one vehicle at a time. Everything here follows from
	# the UAS number by arithmetic, and the stream names follow from the
	# airframe. docs/uas-contract.md is the specification.
	prefix=${SIMNET_PREFIX:-10.200.142}
	say "Fleet: $UAS_COUNT vehicles, from UAS_FLEET"
	for n in $(fleet_numbers); do
		echo
		printf '  %suas%s%s  %s   %s.2%s\n' \
			"$BOLD" "$n" "$OFF" "$(model_of "$n")" "$prefix" "$n"
		printf '    mavlink   system id %s   udp %s to the ground station   tcp://localhost:%s\n' \
			"$n" "$(uas_gcs_port "$n")" "$(uas_tcp_port "$n")"
		printf '    ros       domain %s   namespace /uas%s   frames d%s_ and uas%s_\n' \
			"$(uas_domain "$n")" "$n" "$n" "$n"
		if has_service "onboard$n"; then
			printf '    foxglove  ws://localhost:%s\n' "$(uas_foxglove_port "$n")"
			printf '    compose   uas%s and onboard%s\n' "$n" "$n"
		else
			printf '    foxglove  none. compose.yaml defines no onboard%s\n' "$n"
			printf '    compose   uas%s alone, with no companion\n' "$n"
		fi
		printf '    video     %s\n' "$(streams_of "$n")"
	done
	cat <<EOF

${DIM}  Video is rtsp://localhost:${RTSP_HOST_PORT:-8554}/<name>, or http://localhost:8889/<name> in a
  browser. The full stream is 1920x1080 and the l stream is 640x360, thermal
  excepted: it is 640x512 both ways.

  The ground station holds every vehicle at once: ws://localhost:8765, ROS
  domain $GROUND_DOMAIN, MAVLink in on $(uas_gcs_port "$FIRST_UAS") upwards.${OFF}
EOF
	;;

scenario)
	# A name switches the targets, the way `scene` switches the world. No name
	# places the targets of the scenario already selected, which needs no
	# restart, because that is the file every node already scores against.
	#
	# A switch cannot stop there. The scenario carries the origin and the survey
	# marker, and the scoring nodes are handed its path in their environment, so
	# a container left running scores the new targets against the old ground
	# truth from the old origin, and reports nothing wrong while it does it.
	if [ $# -eq 0 ]; then
		[ -n "${SCENARIO:-}" ] \
			|| die "Give a scenario name, or set SCENARIO in .env. Try: $(scenario_names | paste -sd' ' -)"
		have_scenario "$SCENARIO"
		$DC exec sim /scenes/spawn_scenario.py \
			--world "${SCENE:-recon_field}" --scenario "/scenes/scenarios/${SCENARIO}.yaml"
		exit 0
	fi
	have_scenario "$1"
	was=${SCENARIO:-}
	say "Switching to scenario '$1'"
	export SCENARIO="$1"
	resolve_origin "${SCENE:-}" "$SCENARIO"
	reload_world
	echo "  scenario $SCENARIO   origin ${HOME_LAT:-from the world file}"
	if [ "$was" != "$SCENARIO" ]; then
		warn "SCENARIO in .env still names '${was:-nothing}'. Change it there to"
		warn "keep this scenario, or the next start flies the other one again."
	fi
	say "Wait for 'Ready for takeoff' in ./px4sim logs sim"
	;;

fiducial)
	# Stand the survey marker away from the coordinate the vehicles were given,
	# which is how this simulator holds a frame error. A vehicle cannot tell a
	# displaced marker from a frame of its own displaced the other way, so a
	# survey of it must come back as minus this offset. Zeros put it back,
	# which is what a scoring run needs.
	$DC exec sim /scenes/spawn_scenario.py \
		--world "${SCENE:-recon_field}" --fiducial "${1:-0}" "${2:-0}"
	;;

reset)
	$DC exec sim /scenes/spawn_scenario.py --world "${SCENE:-recon_field}" --clear
	;;

fly)
	# Get a vehicle into the air from the SAME start every time.
	#
	# It always respawns first. Landing this airframe often tips it over, and a
	# vehicle left on its side, armed on the ground, or already flying needs a
	# different recovery each time. Branching on which one it is was tried and
	# it hung: the state read is the fragile part, not the flying. Respawning
	# costs a world reload and removes every branch, so a check that fails
	# after this failed for its own reasons.
	#
	#   ./px4sim fly 11         respawn, then climb to the default height
	#   ./px4sim fly 11 25      to 25 m
	n=$(vehicle_arg "${1:-}"); shift || true
	height=${1:-20}
	add_fleet_profiles

	say "uas$n: respawning for a known start"
	./px4sim place >/dev/null 2>&1

	# ONE budget for the whole wait, not a chain of them. Every marker below is
	# read from the container's own log by id, because the id changes when a
	# container is recreated and because `docker compose logs --tail` drops the
	# line: PX4 writes enough after boot to push "Ready for takeoff" out of any
	# tail window, which is a check that can never match and a loop that never
	# ends. That happened.
	# One budget for the whole wait, never a chain of them: a stage that waits
	# out several deadlines in a row hides which step was slow. Measured on this
	# stack, a companion recreated behind a fresh simulator reaches its first
	# frame either side of 90s, because DeepStream loads its engines and the
	# pipeline then has to reach an RTSP source that is itself still starting.
	# Back to back respawns, which the verification does, land on the slow side.
	ready_by=$((SECONDS + ${FLY_READY_S:-150}))
	world=false
	picture=false
	while true; do
		sim_id=$($DC ps -q sim 2>/dev/null)
		companion=$($DC ps -q "onboard$n" 2>/dev/null)
		# grep -c, never grep -q, and the reason is this script's own
		# `set -o pipefail`. `grep -q` stops at the first match and closes the
		# pipe, so `docker logs` dies of SIGPIPE with status 141 while it still
		# has thousands of lines to write. pipefail then makes the PIPELINE 141
		# even though the line was found, and the match is thrown away. The
		# simulator's log runs to nine thousand lines with a fleet in it, so
		# that check could never pass: it waited out its whole budget and
		# reported a world that never said 'Ready for takeoff' while the log
		# said it. The companion's log is a few hundred lines and usually loses
		# the race the other way, which is why the camera half appeared to work.
		# Counting reads to EOF, so nothing is left writing into a closed pipe.
		[ -n "$sim_id" ] && [ "$(docker logs "$sim_id" 2>&1 \
			| grep -c "Ready for takeoff")" -gt 0 ] && world=true
		[ -n "$companion" ] && [ "$(docker logs "$companion" 2>&1 \
			| grep -cE "camera: [a-z]+$n ready")" -gt 0 ] && picture=true
		[ "$world" = true ] && [ "$picture" = true ] && break
		if [ "$SECONDS" -ge "$ready_by" ]; then
			warn "uas$n was not ready in ${FLY_READY_S:-150}s:"
			[ "$world" = true ] || warn "  the world never said 'Ready for takeoff'. ./px4sim logs sim"
			[ "$picture" = true ] || warn "  the camera never opened. ./px4sim logs onboard$n"
			die "nothing was flown"
		fi
		sleep 2
	done
	say "the world and the camera are up"

	# The autopilot forgets who holds the gimbal across the reboot the respawn
	# causes, while the manager status still names the old owner. Without this
	# the gimbal silently ignores every command and the state looks healthy.
	timeout 60 $DC exec -T "onboard$n" bash -lc '
		. /opt/ros/$ROS_DISTRO/setup.bash
		. /home/user/ros2_ws/install/setup.bash
		exec ros2 topic pub --once -w 1 "$1" std_msgs/msg/Float32 "{data: -361.0}"
		' _ "/uas$n/reassert_gimbal_cmd" >/dev/null 2>&1 || true

	if timeout 300 ./px4sim uas "$n" takeoff "$height" >/dev/null 2>&1; then
		say "uas$n is flying at $height m, from a fresh world"
		exit 0
	fi
	die "uas$n will not climb even from a fresh world. ./px4sim logs sim, ./px4sim logs onboard$n"
	;;

place)
	# Put every vehicle back on its feet at its start. A test that ends badly
	# leaves one on its side, and everything after that reads as a broken
	# stack: the gimbal points into the ground, no ray meets anything, and the
	# next takeoff refuses.
	#
	# This restarts the simulator, because nothing smaller is honest. PX4 owns
	# the vehicle's dynamics and drives the model every step, so moving the
	# Gazebo entity underneath it is overwritten within a step and leaves the
	# estimator arguing with the world. Restarting respawns each vehicle at the
	# pose it was spawned with, with PX4 fresh behind it. The world reloads, so
	# the targets come back where the scenario puts them.
	say "Putting the fleet back at its start. The world reloads, which takes a moment."
	reload_world
	say "respawned:$(fleet_numbers | sed 's/^/ uas/' | tr '\n' ' ')and the pipelines that read them"
	say "Wait for 'Ready for takeoff' in ./px4sim logs sim"
	;;

genscene)
	# The generator runs once and exits. The first use builds its image,
	# which downloads the CPU torch wheel and takes a few minutes.
	# --service-ports exposes 8090 so `genscene edit` reaches the browser.
	COMPOSE_PROFILES="scenegen" exec $DC run --rm --service-ports scenegen "$@"
	;;

verify)   ./verify/run.sh "$@" ;;

capture)
	# Ask a vehicle for a capture the way an operator does. A Foxglove panel
	# publishes this on the ground and the ground bridge carries it into the
	# vehicle's domain, so asking from the ground exercises the link a real
	# ground station uses. Publishing on the vehicle's own domain would answer
	# even with the bridge broken.
	n=$(vehicle_arg "${1:-}"); shift || true
	kind=${1:-mosaic}
	case " $CAPTURE_KINDS " in
	*" $kind "*) ;;
	*) die "capture takes $(echo "$CAPTURE_KINDS" | sed 's/ /, /g'), not '$kind'" ;;
	esac
	say "asking uas$n for a $kind capture, from the ground"
	$DC exec -e ROS_DOMAIN_ID="$GROUND_DOMAIN" offboard bash -lc '
		. /opt/ros/$ROS_DISTRO/setup.bash
		. /home/user/ros2_ws/install/setup.bash
		exec timeout 10 ros2 topic pub --once "$1" std_msgs/msg/Bool "{data: true}"' \
		_ "/uas$n/${kind}_capture_cmd" >/dev/null \
		&& echo "  asked for $kind on /uas$n/${kind}_capture_cmd" \
		|| die "nothing accepted the $kind capture command"
	;;

zoom)
	# Ask the LENS, not the picture. The zoom node owns the framing: it moves
	# the lens and publishes the calibration for the picture it is delivering,
	# so asking it is the only way the two stay together. Driving the Gazebo
	# topic by hand moved the picture alone, and the emulated controller now
	# puts it back on its next status poll anyway.
	#
	# It asks on the topic the operator's Foxglove button publishes, and then
	# waits for the vehicle to report the framing it arrived at. A fire and
	# forget command needs the second half: `ros2 topic pub --once` used to
	# print success here while its sample died with the participant, and a run
	# that believes it is at wide while the lens sits at mid looks like a gross
	# localization failure rather than like a lost message.
	n=$(vehicle_arg "${1:-}")
	preset=${2:?name a framing from: $UAS_ZOOM_PRESETS}
	hfov=$(zoom_hfov_deg "$preset") \
		|| die "No framing '$preset'. This lens has: $UAS_ZOOM_PRESETS"
	[ "$(mark_of "$n")" = v3 ] || die "uas$n is a $(mark_of "$n"), and only a v3 lens zooms."
	add_fleet_profiles
	container=$($DC ps -q "onboard$n" 2>/dev/null)
	[ -n "$container" ] || die "onboard$n is not running. Start it: ./px4sim start"
	docker cp verify/component/zoom.py "$container:/tmp/zoom.py" >/dev/null
	docker cp verify/component/udp-only.xml "$container:/tmp/udp-only.xml" >/dev/null
	say "asking uas$n for the $preset framing, $hfov degrees"
	docker exec -e ROS_DOMAIN_ID="$(uas_domain "$n")" \
		-e FASTRTPS_DEFAULT_PROFILES_FILE=/tmp/udp-only.xml "$container" bash -lc '
		set -e
		. /opt/ros/$ROS_DISTRO/setup.bash
		. /home/user/ros2_ws/install/setup.bash
		exec python3 /tmp/zoom.py "$@"' _ "$n" "$preset" --hfov "$hfov" \
		|| die "uas$n is not at the $preset framing."
	;;

snap)
	# One frame of a live stream, saved where the caller asked. The sim
	# container is on the video network and carries gstreamer, so nothing
	# else needs either.
	stream=${1:?name a stream, e.g. rgb$FIRST_UAS}
	out=${2:-./logs/$stream.jpg}
	add_fleet_profiles
	$DC exec -T sim sh -c 'cat > /tmp/snap.sh' < verify/component/snap.sh
	$DC exec -T sim sh /tmp/snap.sh "$stream" /tmp/snap.jpg >/dev/null
	mkdir -p "$(dirname "$out")"
	docker cp "$($DC ps -q sim):/tmp/snap.jpg" "$out" >/dev/null
	say "$out"
	;;

uas|probe|foxglove)
	# Inside the vehicle's companion, on the vehicle's ROS domain, which is
	# where its nodes are. The tools live in verify/component and are copied
	# in rather than mounted, so this works against a container that compose
	# started with no extra volume.
	add_fleet_profiles
	# `ground` reaches the ground station, which holds every vehicle at once.
	if [ "${1:-}" = ground ]; then
		shift
		container=$($DC ps -q offboard 2>/dev/null)
		[ -n "$container" ] || die "the ground station is not running. Start it: ./px4sim start offboard"
		domain=$GROUND_DOMAIN
		n=$FIRST_UAS
	else
		n=$(vehicle_arg "${1:-}"); shift || true
		container=$($DC ps -q "onboard$n" 2>/dev/null)
		[ -n "$container" ] || die "onboard$n is not running. Start it: ./px4sim start"
		domain=$(uas_domain "$n")
	fi
	case "$cmd" in
	probe)    tool=graph_probe.py ;;
	foxglove) tool=foxglove_probe.py ;;
	*)        tool=uas.py ;;
	esac
	# The default list stands in when no topic is named. An option is not a
	# topic, so `probe 11 --deadline 5` still gets the list.
	named_a_topic=false
	for argument in "$@"; do
		case "$argument" in -*) ;; *) named_a_topic=true ;; esac
	done
	if [ "$cmd" = probe ] && [ "$named_a_topic" = false ]; then
		set -- "/uas$n/state" "/uas$n/global_position/global" \
			"/uas$n/home_position/fix" "/uas$n/camera/camera_info" \
			"/uas$n/gimbal_control/device/attitude_status" \
			"/uas$n/gimbal_lidar_50m" "/uas$n/target_detections" \
			"/uas$n/target_locations" "/uas$n/camera_fov" \
			"/uas$n/ground_projection"
	fi
	[ "$cmd" = uas ] && set -- "$n" "$@"
	docker cp verify/component/uas.py "$container:/tmp/uas.py" >/dev/null
	docker cp verify/component/graph_probe.py "$container:/tmp/graph_probe.py" >/dev/null
	docker cp verify/component/foxglove_probe.py "$container:/tmp/foxglove_probe.py" >/dev/null
	docker cp verify/component/udp-only.xml "$container:/tmp/udp-only.xml" >/dev/null
	# DDS writes its own warnings to stdout, so a caller reading the answer
	# gets them mixed into it. The probe answers in three tab separated fields
	# and nothing else does, so that is what comes back. The Foxglove probe
	# speaks no DDS and has nothing to strip.
	probe_answer() { if [ "$cmd" = probe ]; then awk -F'\t' 'NF == 3'; else cat; fi; }
	docker exec -e ROS_DOMAIN_ID="$domain" \
		-e FASTRTPS_DEFAULT_PROFILES_FILE=/tmp/udp-only.xml "$container" bash -lc '
		set -e
		. /opt/ros/$ROS_DISTRO/setup.bash
		. /home/user/ros2_ws/install/setup.bash
		exec python3 /tmp/'"$tool"' "$@"' _ "$@" | probe_answer
	;;

check)
	$DC config -q && echo "compose.yaml OK"
	# Everything this script names has to exist. A command that reaches a
	# deleted service or script fails in front of a user, and the front door
	# is where that is cheapest to catch.
	problems=0
	for script in preflight bootstrap x11-allow origin-env list-streams state tui lint-docs; do
		case "$script" in list-streams | state | tui) ext=.py ;; *) ext=.sh ;; esac
		[ -x "scripts/$script$ext" ] \
			|| { warn "scripts/$script$ext is missing or not executable."; problems=$((problems + 1)); }
	done
	for service in sim video-router qgc offboard scenegen; do
		has_service "$service" \
			|| { warn "compose.yaml has no $service service, which ./px4sim names."; problems=$((problems + 1)); }
	done
	for n in $(fleet_numbers); do
		for service in "uas$n" "onboard$n"; do
			has_service "$service" \
				|| { warn "compose.yaml has no $service for a fleet of $UAS_COUNT."; problems=$((problems + 1)); }
		done
		[ -d "modules/sim/scenes/models/$(model_of "$n")" ] \
			|| { warn "no model directory for uas$n's '$(model_of "$n")'."; problems=$((problems + 1)); }
	done
	# A shared table is read on the host AND inside the containers, and the two
	# read the same file only if compose passes the variables. It did not pass
	# the framing table, so .env's table never reached a container and both
	# sides quietly used the built-in defaults. Nothing showed, because the
	# defaults matched. This is what that costs to catch.
	for table in scripts/fleet.sh scripts/zoom.sh; do
		[ -f "$table" ] || continue
		while read -r name; do
			# Only the ones a container really reads. compose interpolates
			# others on the host, where passing them would mean nothing.
			grep -rqlw "$name" modules/ 2>/dev/null || continue
			grep -q "^[[:space:]]*$name: " compose.yaml \
				|| { warn "compose.yaml never passes $name, which $table defines and a container reads."
				     problems=$((problems + 1)); }
		done < <(sed -n 's/^\([A-Z][A-Z0-9_]*\)=\${\1:-.*/\1/p' "$table")
	done

	# This script's own case arms. A second arm with the same name is
	# unreachable, and the copy that is never run is the one that gets edited.
	duplicates=$(grep -o '^[a-z][a-z|]*)' "$0" | sort | uniq -d)
	if [ -n "$duplicates" ]; then
		warn "px4sim answers to these more than once: $(echo "$duplicates" | tr -d ')' | tr '\n' ' ')"
		problems=$((problems + 1))
	fi

	# Parameter files, as rcl reads them rather than as YAML does. A node whose
	# ros__parameters block has nothing left in it stops that node dead at
	# launch, and the file still parses and still looks right.
	params_dir=${ROS2_WS_DIR:-../ros2_ws}/src/5g_drone/config/param_files
	if [ -d "$params_dir" ]; then
		# shellcheck disable=SC2044
		if faults=$(find "$params_dir" -name '*.yaml' -print0 \
				| xargs -0 python3 verify/component/param_files.py); then
			echo "parameter files OK: every node block carries a parameter"
		else
			warn "$faults"
			problems=$((problems + 1))
		fi
	fi

	# The operator's console. One value Foxglove rejects takes the whole
	# panel's settings with it and says nothing, and a panel with no place in
	# the layout is never drawn at all.
	layout=${FOXGLOVE_LAYOUT:-${ROS2_WS_DIR:-../ros2_ws}/src/5g_drone/config/foxglove/chimera_sim.json}
	if [ -f "$layout" ]; then
		if faults=$(python3 verify/component/foxglove_layout.py "$layout"); then
			echo "layout OK: every panel setting is one Foxglove accepts, and every panel is drawn"
		else
			warn "$layout: $faults"
			problems=$((problems + 1))
		fi
	fi

	# The simulated gimbal is wrong in three ways without these, and each one
	# points plausibly rather than failing.
	if [ -d src/PX4-Autopilot/.git ]; then
		for patch in patches/px4-*.patch; do
			grep -qx "$(md5sum "$patch" | cut -d' ' -f1) $(basename "$patch")" \
				src/PX4-Autopilot/.px4sim-patches 2>/dev/null \
				|| { warn "$(basename "$patch") is not applied. Run ./px4sim setup px4."
				     problems=$((problems + 1)); }
		done
	fi

	[ "$problems" = 0 ] && echo "front door OK: every service, profile, script and variable it names exists"
	./scripts/lint-docs.sh
	[ "$problems" = 0 ] || die "The front door names something that does not exist. See the warnings above."
	;;

clean)
	say "Removing containers, networks and volumes"
	COMPOSE_PROFILES="$ALL_PROFILES" $DC down -v --remove-orphans
	;;

clean-src)
	say "Deleting the cloned upstream sources in ./src"
	rm -rf src/PX4-Autopilot src/qgroundcontrol
	;;

nuke)
	printf 'This deletes the containers, the volumes and ./src (%s). Continue? [y/N] ' \
		"$(du -sh src 2>/dev/null | cut -f1 || echo 'not present')"
	read -r reply
	case "$reply" in
		[yY]*) COMPOSE_PROFILES="$ALL_PROFILES" $DC down -v --remove-orphans
		       rm -rf src/PX4-Autopilot src/qgroundcontrol
		       say "Gone. Run ./px4sim setup to start again." ;;
		*)     echo "Nothing was removed." ;;
	esac
	;;

help|-h|--help) usage ;;
*)              echo "Unknown command: $cmd"; echo; usage; exit 1 ;;
esac
}

main "$@"
