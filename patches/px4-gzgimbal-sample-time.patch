 	}
 
 	pthread_mutex_unlock(&_node_mutex);
@@ -124,6 +123,15 @@
 	_gimbal_rate[0] = rate(0);
 	_gimbal_rate[1] = rate(1);
 	_gimbal_rate[2] = rate(2);
+
+	// Publish at the sensor callback, so the report does not wait for Run().
+	const uint64_t sample_time = (uint64_t)IMU_data.header().stamp().sec() * 1000000ULL
+				    + IMU_data.header().stamp().nsec() / 1000;
+
+	if (_mnt_mode_out == 2 && sample_time / 20000 > _last_attitude_publish / 20000) {
+		_last_attitude_publish = sample_time;
+		publishDeviceAttitude();
+	}
 
 	pthread_mutex_unlock(&_node_mutex);
 }
