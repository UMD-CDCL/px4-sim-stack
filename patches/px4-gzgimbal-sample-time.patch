Publish gimbal attitude from each fresh sensor sample, limited to 50 Hz.

--- a/src/modules/simulation/gz_bridge/GZGimbal.cpp
+++ b/src/modules/simulation/gz_bridge/GZGimbal.cpp
@@ -91,7 +91,6 @@
 	if (_mnt_mode_out == 2) {
