--- a/src/modules/simulation/gz_bridge/GZGimbal.cpp
+++ b/src/modules/simulation/gz_bridge/GZGimbal.cpp
@@ -214,17 +214,79 @@
 
 	gimbal_att.target_system = 0; // Broadcast
 	gimbal_att.target_component = 0; // Broadcast
-	gimbal_att.device_flags = gimbal_device_attitude_status_s::DEVICE_FLAGS_YAW_IN_VEHICLE_FRAME;
-	_q_gimbal.copyTo(gimbal_att.q);
+
+	// Report the axis locks that the last setpoint asked for, which is what a
+	// MAVLink gimbal device does: the report gives the mode the device is in.
+	// GIMBAL_DEVICE_FLAGS is one MAVLink enum, so the setpoint bits and the
+	// report bits are the same numbers.
+	const uint16_t lock_flags = (uint16_t)(_gimbal_device_flags &
+					       (gimbal_device_attitude_status_s::DEVICE_FLAGS_ROLL_LOCK |
+						gimbal_device_attitude_status_s::DEVICE_FLAGS_PITCH_LOCK |
+						gimbal_device_attitude_status_s::DEVICE_FLAGS_YAW_LOCK));
+
+	// Say the frame of the report again in the flags that state it directly.
+	// The specification tells a new implementation to set one of the two.
+	const uint16_t frame_flag = (lock_flags & gimbal_device_attitude_status_s::DEVICE_FLAGS_YAW_LOCK) ?
+				    gimbal_device_attitude_status_s::DEVICE_FLAGS_YAW_IN_EARTH_FRAME :
+				    gimbal_device_attitude_status_s::DEVICE_FLAGS_YAW_IN_VEHICLE_FRAME;
+
+	gimbal_att.device_flags = (uint16_t)(lock_flags | frame_flag);
+
+	// _q_gimbal comes from the gimbal IMU, which Gazebo measures against the
+	// world, so it holds the camera attitude in the earth frame. The report
+	// must give that attitude in the frame the flags above declare, or a
+	// consumer that builds the frame from the flags applies the airframe
+	// attitude a second time.
+	const matrix::Quatf q_vehicle = vehicleAttitude();
+	const matrix::Quatf q_reference = attitudeReferenceFrame(lock_flags, q_vehicle);
+	const matrix::Quatf q_report = q_reference.inversed() * _q_gimbal;
+
+	q_report.copyTo(gimbal_att.q);
 	gimbal_att.angular_velocity_x = _gimbal_rate[0];
 	gimbal_att.angular_velocity_y = _gimbal_rate[1];
 	gimbal_att.angular_velocity_z = _gimbal_rate[2];
+	// The yaw between the earth frame and the vehicle frame, which lets a
+	// consumer move the report from one to the other. The rates stay in the
+	// gimbal body axes, so the rate that goes with it is not known here.
+	gimbal_att.delta_yaw = matrix::Eulerf(q_vehicle).psi();
+	gimbal_att.delta_yaw_velocity = NAN;
 	gimbal_att.failure_flags = 0;
 	gimbal_att.timestamp = hrt_absolute_time();
 
 	_gimbal_device_attitude_status_pub.publish(gimbal_att);
 }
 
+matrix::Quatf GZGimbal::vehicleAttitude()
+{
+	vehicle_attitude_s vehicle_attitude;
+
+	if (_vehicle_attitude_sub.copy(&vehicle_attitude)) {
+		_q_vehicle = matrix::Quatf(vehicle_attitude.q);
+	}
+
+	// Holds the last estimate. Before the first one it is the identity, which
+	// makes the earth frame and the airframe one frame.
+	return _q_vehicle;
+}
+
+matrix::Quatf GZGimbal::attitudeReferenceFrame(const uint16_t lock_flags, const matrix::Quatf &q_vehicle)
+{
+	if (lock_flags & gimbal_device_attitude_status_s::DEVICE_FLAGS_YAW_LOCK) {
+		// Yaw is held against North, so the report is in the earth frame.
+		return matrix::Quatf();
+	}
+
+	if (lock_flags != 0) {
+		// Roll or pitch is held against the horizon while yaw follows the
+		// airframe. That is the MAVLink vehicle frame: the earth frame turned
+		// by the heading of the airframe, and level.
+		return matrix::Quatf(matrix::Eulerf(0.0f, 0.0f, matrix::Eulerf(q_vehicle).psi()));
+	}
+
+	// No axis is held, so every axis is measured against the airframe.
+	return q_vehicle;
+}
