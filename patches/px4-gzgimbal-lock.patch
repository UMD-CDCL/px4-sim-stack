+void GZGimbal::jointAnglesFromAttitude(const matrix::Quatf &q, float &roll, float &pitch, float &yaw)
+{
+	// The arms turn in the order model.sdf builds them: the vertical arm about
+	// the yaw axis, then the horizontal arm about the roll axis, then the
+	// camera about the pitch axis. So the attitude they build is
+	//
+	//     R = Rz(yaw) * Rx(roll) * Ry(pitch)
+	//
+	// and the angles that build a wanted attitude have to be read back out of
+	// it in that same order.
+	//
+	// matrix::Eulerf reads Rz * Ry * Rx, the aerospace order, which puts pitch
+	// before roll. The two orders give the same three angles only while roll is
+	// zero. Every command this simulator ever saw had roll zero, because PX4
+	// commands roll zero by default and the Chimera flight code sends a level
+	// horizon, so the difference stayed invisible until the lock flags started
+	// asking for roll.
+	//
+	// The error is not small. Reading a stabilization setpoint in the aerospace
+	// order and writing it onto these arms misses by up to 40 degrees, and it
+	// misses most where the camera is pitched furthest down, which is where the
+	// camera spends its time.
+	//
+	// The five entries of the rotation matrix that this order needs, straight
+	// from the quaternion, so this file needs no header it does not have.
+	const float w = q(0), x = q(1), y = q(2), z = q(3);
+	const float r21 = 2.f * (y * z + w * x);
+	const float r20 = 2.f * (x * z - w * y);
+	const float r22 = 1.f - 2.f * (x * x + y * y);
+	const float r01 = 2.f * (x * y - w * z);
+	const float r11 = 1.f - 2.f * (x * x + z * z);
+
+	roll = asinf(math::constrain(r21, -1.f, 1.f));
+	pitch = atan2f(-r20, r22);
+	yaw = atan2f(-r01, r11);
+}
+
+bool GZGimbal::applyLockedSetpoint()
+{
+	// The MAVLink contract: a lock flag says the axis is commanded against the
+	// world rather than against the airframe. ROLL_LOCK and PITCH_LOCK put the
+	// setpoint in a level frame at the airframe heading, and YAW_LOCK puts it
+	// in the earth frame. The joints turn against the airframe, so the airframe
+	// attitude has to come off before the angles are written, or a banked
+	// aircraft rolls the horizon out of the picture.
+	//
+	// attitudeReferenceFrame() already names that frame for the report. This is
+	// the same arithmetic the other way round:
+	//
+	//     report:  q_report = conj(q_reference) * q_camera
+	//     command: q_joint   = conj(q_vehicle) * q_reference * q_setpoint
+	//
+	// With no lock bit the reference frame is the airframe, the two conjugates
+	// cancel and the joints take the setpoint unchanged, which is what a follow
+	// mode device does and what this file did for every command before.
+	const uint16_t lock_flags = (uint16_t)(_gimbal_device_flags &
+					       (gimbal_device_attitude_status_s::DEVICE_FLAGS_ROLL_LOCK |
+						gimbal_device_attitude_status_s::DEVICE_FLAGS_PITCH_LOCK |
+						gimbal_device_attitude_status_s::DEVICE_FLAGS_YAW_LOCK));
+
+	if (!_setpoint_is_attitude || lock_flags == 0) {
+		return false;
+	}
+
+	const matrix::Quatf q_vehicle = vehicleAttitude();
+	const matrix::Quatf q_reference = attitudeReferenceFrame(lock_flags, q_vehicle);
+
+	jointAnglesFromAttitude(matrix::Quatf(q_vehicle.inversed() * q_reference * _q_setpoint),
+				_roll_stp, _pitch_stp, _yaw_stp);
+
+	return true;
+}
