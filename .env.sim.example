# Simulator laptop. Copy to .env, then run ./px4sim preflight.
COMPOSE_PROFILES=sim,offboard
UAS_BASE=10
UAS_FLEET="chimera_v3 chimera_v3 chimera_v2 chimera_v2"
UAS_ACTIVE="11 12 13 14"
UAS_STREAMS="gimbal"
SCENE=uroc
SCENARIO=uroc_casualties
SIMNET_PREFIX=172.28.0
GZ_GUI=0
SIM_SPEED_FACTOR=1

# Keep these aligned with the real aircraft calibration.
UAS_GIMBAL_HFOV_DEG="56.06 56.06 85.25 25.98"
UAS_THERMAL_HFOV_DEG="29.75 29.75 31.03 29.75"
UAS_DOWN_HFOV_DEG="25.98 25.98 25.98 25.98"
UAS_ZOOM="mid mid - -"

# Reuse prepared images; change refs only when deliberately rebuilding.
PX4SIM_PINNED_DEPS=1
PX4SIM_REUSE_PREPARED_IMAGES=1
